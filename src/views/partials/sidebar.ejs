    <div class="sidebar-logo">
        <i class="bi bi-bus-front-fill"></i>
    </div>

    <div>
        <h5>Bus Status</h5>
        <span>Transporte Público</span>
    </div>

</div>


<!-- MENU -->
<div class="sidebar-menu">

    <!-- USUÁRIO -->
