            <li>
                <a class="nav-link" href="/admin/usuario/cadastrar">
                    <i class="bi bi-person-plus"></i>
                    <span>Cadastrar Usuário</span>
                </a>
            </li>

            <li>
                <a class="nav-link" href="/usuario/listar">
                    <i class="bi bi-people"></i>
                    <span>Listar Usuários</span>
                </a>
