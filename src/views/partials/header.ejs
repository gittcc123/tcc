</style>


<script>

document.addEventListener("DOMContentLoaded", function () {

    const botaoMenu = document.getElementById("toggleSidebar");

    if (!botaoMenu) {
        return;
    }


    /*
     * Evita registrar o evento duas vezes
     * caso o header seja carregado novamente.
     */

    if (botaoMenu.dataset.menuInicializado === "true") {
        return;
    }

    botaoMenu.dataset.menuInicializado = "true";


    botaoMenu.addEventListener("click", function (event) {

        event.preventDefault();
        event.stopPropagation();


        /*
         * Fecha/abre a sidebar
         */
        document.body.classList.toggle("sidebar-fechada");


        /*
         * Atualiza acessibilidade
         */
        const aberto =
            !document.body.classList.contains("sidebar-fechada");

        botaoMenu.setAttribute(
            "aria-expanded",
            aberto ? "true" : "false"
        );

    });

});

</script>
