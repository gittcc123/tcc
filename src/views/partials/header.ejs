<style>

.bus-header {
    height: 58px;
    background: #7a1f1f;
    padding: 0;
    position: relative;
    z-index: 1100;
}

.bus-header-container {
    height: 100%;
    padding: 0 18px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;
}

.bus-header-left {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 12px;
}

.bus-menu-button {
    width: 42px;
    height: 40px;

    padding: 0;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 21px;

    border-radius: 6px;

    cursor: pointer;
}

.bus-menu-button:hover {
    background: rgba(255, 255, 255, 0.12);
}

.bus-brand {
    margin: 0;
    padding: 0;

    color: #fff !important;

    font-size: 16px;
    font-weight: 700;

    white-space: nowrap;

    overflow: hidden;
    text-overflow: ellipsis;
}

.bus-user {
    flex-shrink: 0;
}

.bus-user-link {
    display: flex;
    align-items: center;

    padding: 8px 10px;

    font-size: 14px;
    font-weight: 500;

    white-space: nowrap;

    border-radius: 6px;
}

.bus-user-link:hover {
    background: rgba(255, 255, 255, 0.08);
}

.bus-user .dropdown-menu {
    min-width: 180px;

    margin-top: 5px !important;

    border: none;
    border-radius: 7px;

    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.bus-user .dropdown-item {
    padding: 9px 14px;

    font-size: 13px;
}


/* =========================================================
   SIDEBAR FECHADA
   ========================================================= */

/*
   O JavaScript adiciona/removerá esta classe no BODY.
   Isso permite funcionar independentemente da página.
*/

body.sidebar-fechada .sidebar,
body.sidebar-fechada .bus-sidebar {
    width: 0 !important;
    min-width: 0 !important;
    overflow: hidden !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    border: 0 !important;
}

body.sidebar-fechada .content {
    margin-left: 0 !important;
    width: 100% !important;
}

body.sidebar-fechada .bus-content,
body.sidebar-fechada main {
    margin-left: 0 !important;
}


/* =========================================================
   TRANSIÇÃO
   ========================================================= */

.sidebar,
.bus-sidebar,
.content,
.bus-content,
main {
    transition:
        width 0.25s ease,
        margin-left 0.25s ease,
        padding-left 0.25s ease,
        padding-right 0.25s ease;
}


/* =========================================================
   TABLET / CELULAR
   ========================================================= */

@media (max-width: 768px) {

    .bus-header {
        height: 54px;
    }

    .bus-header-container {
        padding-left: 8px;
        padding-right: 8px;

        gap: 6px;
    }

    .bus-header-left {
        flex: 1;
        min-width: 0;

        gap: 8px;
    }

    .bus-menu-button {
        width: 38px;
        height: 36px;

        font-size: 19px;

        flex-shrink: 0;

        margin: 0 !important;
    }

    .bus-brand {
        font-size: 14px;

        min-width: 0;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bus-user-link {
        padding: 6px 5px;

        font-size: 12px;

        gap: 3px;
    }

    .bus-user-link::after {
        margin-left: 3px;
    }

    .bus-user .dropdown-menu {
        min-width: 160px;
    }
}


@media (max-width: 430px) {

    .bus-header {
        height: 52px;
    }

    .bus-header-container {
        padding-left: 6px;
        padding-right: 6px;

        gap: 4px;
    }

    .bus-header-left {
        gap: 6px;
    }

    .bus-menu-button {
        width: 36px;
        height: 34px;

        font-size: 18px;
    }

    .bus-brand {
        font-size: 12px;
    }

