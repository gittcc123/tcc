<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8">
  <title>Bus Status - Início</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root{
      --red: #D62828;
      --red-deep: #8B1E1E;
      --amber: #D62828;
      --teal: #1F6F5C;
      --ink: #14110F;
      --paper: #FFFFFF;
      --grey: #6E6A63;
      --cream: #FBF6EE;
    }

    body {
      background: var(--paper);
      font-family: 'Archivo', system-ui, sans-serif;
      color: var(--ink);
    }

    /* Navbar */
    .navbar {
      background: var(--ink);
    }
    .navbar-brand {
      font-weight: 900;
      letter-spacing: -.01em;
      color: #fff !important;
    }
    .navbar-brand span { color: var(--red); }
    .navbar .nav-link { font-weight: 600; }

    .offcanvas.text-bg-dark { background: var(--ink) !important; }
    .offcanvas .nav-link.active { color: var(--amber) !important; }

    /* Hero: photo + red duotone */
    .search-hero {
      position: relative;
      color: white;
      padding: 100px 0 110px;
      overflow: hidden;
      isolation: isolate;
    }
    .search-hero .hero-photo {
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1607207807806-075f273b0d0d?auto=format&fit=crop&w=2000&q=70');
      background-size: cover;
      background-position: center 65%;
      filter: grayscale(1) contrast(1.15);
      z-index: -2;
    }
    .search-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(125deg, rgba(139,30,30,.94), rgba(214,40,40,.85) 45%, rgba(20,17,15,.9));
      z-index: -1;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.3);
      padding: 6px 14px;
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 20px;
    }
    .hero-eyebrow .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 3px rgba(242,169,59,.3);
    }

    .search-hero h1 {
      font-weight: 900;
      font-size: clamp(34px, 4.6vw, 54px);
      letter-spacing: -.01em;
      line-height: 1.05;
    }
    .search-hero .lead {
      color: #F3E6E6 !important;
      font-weight: 500;
      font-size: 16.5px;
      max-width: 48ch;
      line-height: 1.6;
    }

    .search-card {
      background: rgba(255,255,255,.97);
      padding: 22px;
      box-shadow: 0 20px 45px rgba(0,0,0,.35);
    }

    .form-control, .form-select {
      border-radius: 0;
      border: 1.5px solid #E4DED2;
      font-weight: 500;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 .15rem rgba(214,40,40,.15);
    }

    .form-button {
      background: var(--red);
      color: white;
      border: none;
      width: 100%; height: 100%;
      font-weight: 800;
      letter-spacing: .02em;
    }
    .form-button:hover { background: var(--red-deep); color: white; }

    /* Live strip */
    .live-strip {
      background: var(--ink);
      color: #fff;
      padding: 18px 0;
    }
    .live-strip .item {
      display: flex; align-items: baseline; gap: 10px;
      font-size: 14px; font-weight: 600; color: #C9C4B9;
    }
    .live-strip .item b {
      font-size: 26px; font-weight: 900; color: var(--amber);
    }

    /* Feature section */
    .titulo-secao {
      color: var(--ink);
      font-weight: 800;
      margin-bottom: 8px;
      font-size: 28px;
      letter-spacing: -.01em;
    }
    .secao-sub {
      color: var(--grey);
      font-weight: 500;
      margin-bottom: 36px;
      max-width: 52ch;
    }

    .station-card {
      background: #fff;
      border: 1.5px solid #ECE7DB;
      overflow: hidden;
      height: 100%;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .station-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 18px 32px rgba(20,17,15,.12);
    }

    .cover-wrap {
      position: relative;
      height: 190px;
      overflow: hidden;
    }
    .cover {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .3s ease;
    }
    .station-card:hover .cover { transform: scale(1.06); }
    .cover-wrap::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(200deg, rgba(214,40,40,.55), rgba(139,30,30,.25) 60%, transparent);
      mix-blend-mode: multiply;
    }

    .card-body { padding: 22px 24px 24px; }
    .card-title { color: var(--ink); font-weight: 800; }

    .badge-status { background: #f5e5e4; color: #f12c2c; font-weight: 700; font-size: 11.5px; padding: 5px 11px; }
    .badge-warn { background: #FCEFDA; color: #B5680B; font-weight: 700; font-size: 11.5px; padding: 5px 11px; }
    .badge-info { background: #E9EEFB; color: #2C4FB0; font-weight: 700; font-size: 11.5px; padding: 5px 11px; }

    .btn-chip {
      border: none;
      background: var(--ink);
      color: #fff;
      border-radius: 0;
      font-weight: 700;
      font-size: 13px;
      padding: 9px 20px;
    }
    .btn-chip:hover { background: var(--red); color: white; }

    /* Alerts band */
    .alert-band {
      background: var(--cream);
      padding: 56px 0;
      border-top: 1.5px solid #ECE7DB;
      border-bottom: 1.5px solid #ECE7DB;
    }
    .alert-row {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #fff;
      border-left: 5px solid var(--teal);
      padding: 16px 20px;
      margin-bottom: 12px;
      font-weight: 600;
      font-size: 14px;
    }

    .alert-row.warn { border-left-color: var(--amber); }
    .alert-row.info { border-left-color: var(--red); }
    .alert-row .tag {
      font-size: 11px; font-weight: 800; letter-spacing: .03em;
      color: var(--grey);
    }

    footer {
      background: var(--ink);
      color: #C9C4B9;
      margin-top: 0;
      font-size: 13px;
      font-weight: 500;
    }
    footer span { color: var(--amber); font-weight: 800; }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark shadow">

    <div class="container">

      <a class="navbar-brand fw-bold" href="/">
        Bus<span>Status</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu">

        <span class="navbar-toggler-icon"></span>

      </button>

      <div class="offcanvas offcanvas-end text-bg-dark" id="menu">

        <div class="offcanvas-header">

          <h5 class="offcanvas-title">
            Menu
          </h5>

          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas">
          </button>

        </div>

        <div class="offcanvas-body">

          <ul class="navbar-nav ms-auto">

            <li class="nav-item">
              <a class="nav-link active" href="/">
                Início
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/usuario/logar">
                Entrar
              </a>
            </li>

          </ul>

        </div>

      </div>

    </div>

  </nav>

  <!-- Hero -->
  <section class="search-hero">

    <div class="hero-photo"></div>

    <div class="container">

      <div class="row align-items-center">

        <div class="col-lg-6">

          <span class="hero-eyebrow"><span class="dot"></span> Rede monitorada agora</span>

          <h1 class="mb-3">
            Acompanhe ônibus e rotas em tempo real
          </h1>

          <p class="lead">
            Consulte linhas, horários, veículos em circulação e informações atualizadas do transporte público.
          </p>

        </div>

        <div class="col-lg-6">

        </div>

      </div>

    </div>

  </section>


  <!-- Cards -->
  <main class="container py-5">

    <h2 class="titulo-secao">
      Informações em Destaque
    </h2>
    <p class="secao-sub">
      Tudo o que você precisa para se planejar hoje, direto da central de monitoramento.
    </p>

    <div class="row g-4">

      <div class="col-md-4">

        <div class="station-card">

          <div class="cover-wrap">
            <img src="/img/cidade-aerea.jpg" class="cover" alt="cidade">
          </div>

          <div class="card-body">

            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0">Linhas</h5>
              <span class="badge-status">Em rota</span>
            </div>

            <p class="text-muted">
              Monitoramento em tempo real da linha.
            </p>

            <a href="/dashboard" class="btn btn-chip">
              Ver detalhes
            </a>

          </div>

        </div>

      </div>

      <div class="col-md-4">

        <div class="station-card">

          <div class="cover-wrap">
            <img src="/img/images-rotas.jpg" class="cover" alt="Rota de ônibus na cidade">
          </div>

          <div class="card-body">

            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0">Rotas Ativas</h5>
            </div>

            <p class="text-muted">
              Consulte os trajetos disponíveis.
            </p>

            <a href="/dashboard" class="btn btn-chip">
              Visualizar
            </a>

          </div>

        </div>

      </div>

      <div class="col-md-4">

        <div class="station-card">

          <div class="cover-wrap">
            <img src="/img/alerta.svg" class="cover" alt="Transporte público à noite">
          </div>

          <div class="card-body">

            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0">Alertas</h5>
            </div>

            <p class="text-muted">
              Avisos importantes sobre o sistema.
            </p>

            <a href="/dashboard" class="btn btn-chip">
              Consultar
            </a>

          </div>

        </div>

      </div>

    </div>

  </main>

  <!-- Quick alerts -->
  <section class="alert-band">
    <div class="container">
      <h2 class="titulo-secao">Informações Rápidas (simulação)</h2>

      <div class="alert-row">
        <span class="tag">LINHA 101</span> Operando normalmente.
      </div>
      <div class="alert-row warn">
        <span class="tag">LINHA 102</span> Atraso estimado de 5 minutos.
      </div>
      <div class="alert-row info">
        <span class="tag">SISTEMA</span> Atualizado em tempo real.
      </div>
    </div>
  </section>

  <footer class="py-4">

    <div class="container text-center">

      Bus<span>Status</span> — Monitoramento de Transporte Público

    </div>

  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
