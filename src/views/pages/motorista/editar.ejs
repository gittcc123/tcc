<!DOCTYPE html>

<html lang="pt-BR">

<%- include('../../partials/head') %>

<body class="bg-light">

<%- include('../../partials/header') %>

<div class="d-flex">

    <%- include('../../partials/sidebar') %>

    <main class="content w-100">

        <div class="container-fluid px-4 py-4">

            <!-- CABEÇALHO -->

            <div class="page-header mb-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="d-flex align-items-center gap-2 mb-2">

                            <div class="page-icon">
                                <i class="bi bi-person-gear"></i>
                            </div>

                            <h1 class="fw-bold mb-0">
                                Editar Motorista
                            </h1>

                        </div>

                      

                    </div>

                    <a
                        href="/motorista/listar"
                        class="btn btn-light border shadow-sm px-3"
                    >
                        <i class="bi bi-arrow-left me-1"></i>
                        Voltar
                    </a>

                </div>

            </div>


            <!-- MENSAGEM -->

            <% if (typeof mensagem !== 'undefined' && mensagem) { %>

                <div
                    class="alert alert-<%= mensagem.tipo === 'success' ? 'success' : 'danger' %> border-0 shadow-sm mb-4"
                    role="alert"
                >

                    <div class="d-flex align-items-start">

                        <i
                            class="bi <%= mensagem.tipo === 'success'
                                ? 'bi-check-circle-fill'
                                : 'bi-exclamation-triangle-fill' %> fs-5 me-3"
                        ></i>

                        <div>

                            <strong>
                                <%= mensagem.tituloMensagem || 'Mensagem' %>
                            </strong>

                            <div>
                                <%= mensagem.valor %>
                            </div>

                        </div>

                    </div>

                </div>

            <% } %>


            <!-- CARD -->

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-lg-5">

                    <!-- USUÁRIO SELECIONADO -->

                    <div class="selected-user mb-4">

                        <div class="selected-user-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="selected-user-info">

                            <span class="selected-user-label">
                                Motorista selecionado
                            </span>

                            <strong>
                                <%= motoristaParaEditar.usuario.nome %>
                            </strong>

                            <small>
                                <%= motoristaParaEditar.usuario.email %>
                            </small>

                        </div>

                        <div class="selected-user-status">
                            <i class="bi bi-lock-fill me-1"></i>
                            Vinculado
                        </div>

                    </div>


                    <div class="section-title mb-4">

                        <h5>
                            Informações editáveis
                        </h5>

                        <p>
                            Altere somente os dados necessários deste motorista.
                        </p>

                    </div>


                    <form
                        action="/motorista/editar/<%= motoristaParaEditar.id %>"
                        method="POST"
                    >

                        <!-- IMPORTANTE:
                             Mantém o ID do usuário no formulário,
                             mas ele não aparece como campo editável.
                        -->

                        <input
                            type="hidden"
                            name="usuario_id"
                            value="<%= motoristaParaEditar.usuario.id %>"
                        >


                        <div class="row g-4">


                            <!-- TELEFONE -->

                            <div class="col-md-6">

                                <label
                                    for="telefone"
                                    class="form-label fw-semibold"
                                >
                                    <i class="bi bi-telephone me-1"></i>
                                    Telefone
                                </label>

                                <input
                                    type="text"
                                    id="telefone"
                                    name="telefone"
                                    class="form-control"
                                    value="<%= motoristaParaEditar.telefone || '' %>"
                                    placeholder="(17) 99999-9999"
                                    maxlength="20"
                                    required
                                >

                                <div class="form-text">
                                    Telefone utilizado para contato com o motorista.
                                </div>

                            </div>


                            <!-- STATUS -->

                            <div class="col-md-6">

                                <label
                                    for="ativo"
                                    class="form-label fw-semibold"
                                >
                                    <i class="bi bi-toggle-on me-1"></i>
                                    Status
                                </label>

                                <select
                                    id="ativo"
                                    name="ativo"
                                    class="form-select"
                                    required
                                >

                                    <option
                                        value="true"
                                        <%= motoristaParaEditar.ativo ? 'selected' : '' %>
                                    >
                                        Ativo
                                    </option>

                                    <option
                                        value="false"
                                        <%= !motoristaParaEditar.ativo ? 'selected' : '' %>
                                    >
                                        Inativo
                                    </option>

                                </select>

                                <div class="form-text">
                                    Define se o motorista está ativo no sistema.
                                </div>

                            </div>

                        </div>


                        <!-- BOTÕES -->

                        <div class="form-actions mt-5 pt-4">

                            <a
                                href="/motorista/listar"
                                class="btn btn-light border px-4"
                            >
                                Cancelar
                            </a>

                            <button
                                type="submit"
                                class="btn btn-danger px-4"
                            >
                                <i class="bi bi-check-lg me-1"></i>
                                Salvar alterações
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </main>

</div>


<style>

    .content {
        min-height: calc(100vh - 70px);
        background: #f4f6f9;
    }

    .page-header {
        background: #ffffff;
        border-left: 4px solid #8b2e2e;
        border-radius: 10px;
        padding: 20px 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .page-header h1 {
        color: #7a1f1f;
        font-size: 1.55rem;
    }

    .page-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(139, 46, 46, 0.10);
        color: #8b2e2e;
        font-size: 1.2rem;
    }

    .selected-user {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        background: #fafafa;
        border: 1px solid #e7e7e7;
        border-radius: 10px;
    }

    .selected-user-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f0dddd;
        color: #8b2e2e;
        font-size: 1.2rem;
    }

    .selected-user-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .selected-user-label {
        color: #777;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 2px;
    }

    .selected-user-info strong {
        color: #292929;
        font-size: 1rem;
    }

    .selected-user-info small {
        color: #777;
        margin-top: 2px;
    }

    .selected-user-status {
        color: #666;
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .section-title {
        border-bottom: 1px solid #eeeeee;
        padding-bottom: 14px;
    }

    .section-title h5 {
        color: #333;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .section-title p {
        color: #777;
        margin: 0;
        font-size: 0.9rem;
    }

    .form-label {
        color: #333;
    }

    .form-label i {
        color: #8b2e2e;
    }

    .form-control,
    .form-select {
        min-height: 46px;
        border: 1px solid #d8d8d8;
        border-radius: 8px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #8b2e2e;
        box-shadow: 0 0 0 0.18rem rgba(139, 46, 46, 0.12);
    }

    .form-text {
        color: #777;
        font-size: 0.82rem;
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #eeeeee;
    }

    .btn-danger {
        background: #8b2e2e;
        border-color: #8b2e2e;
    }

    .btn-danger:hover {
        background: #7a1f1f;
        border-color: #7a1f1f;
    }

    @media (max-width: 768px) {

        .container-fluid {
            padding-left: 15px !important;
            padding-right: 15px !important;
        }

        .page-header {
            padding: 18px;
        }

        .page-header > div {
            align-items: flex-start !important;
            gap: 15px;
        }

        .page-header h1 {
            font-size: 1.3rem;
        }

        .selected-user {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .selected-user-status {
            width: 100%;
            margin-left: 60px;
        }

        .card-body {
            padding: 22px !important;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }

    }

</style>


<%- include('../../partials/scripts') %>


</body>
</html>
