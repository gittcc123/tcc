                                        type="button"
                                        data-aba="onibus"
                                    >
                                        Ônibus
                                    </button>

                                    <button
                                        type="button"
                                        data-aba="rotas"
                                    >
                                        Rotas
                                    </button>

                                </div>

                                <div
                                    class="chips-wrapper"
                                    id="chips-wrapper"
                                >

                                    <div
                                        class="chips"
                                        id="chips-cidades"
                                    ></div>

                                </div>

                                <div id="lista-pontos"></div>

                                <div
                                    id="lista-onibus"
                                    style="display:none"
