                            </div>

                        </div>

                    </div>

                </main>

        </div>

        <%- include('../../partials/scripts') %>

            <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

            <script id="rotas-data" type="application/json">
                <%- JSON.stringify(typeof rotas !== 'undefined' ? rotas : []) %>
            </script>

            <script>

                /* =========================================================
                   DADOS INICIAIS
                ========================================================= */

                const rotas = JSON.parse(
                    document.getElementById('rotas-data').textContent
                );

                const tipoUsuario =
                    "<%= typeof usuario !== 'undefined' && usuario ? usuario.tipo : '' %>";

                const POSICAO_PADRAO = [-20.2111, -50.9258];

                const VELOCIDADE_ONIBUS = 8;

                const TEMPO_PARADA = 8;

                const FATOR_RUA = 1.3;

                const map = L.map('map', {
                    zoomControl: false
                }).setView(POSICAO_PADRAO, 13);

                L.tileLayer(
                    'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                    {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap'
                    }
                ).addTo(map);

                const ehDesktop = () => window.innerWidth >= 992;

                const areaMapa =
                    document.getElementById('mapa-area');

                const sheet =
                    document.getElementById('sheet');

                let estadoSheet = 'mid';

                let abaAtual = 'pontos';

                let cidadeAtual = 'Todas';

                let termoBusca = '';

                const cacheHTML = {};

                let rotaAtiva = null;

                if (ehDesktop()) {
                    L.control.zoom({
                        position: 'topright'
                    }).addTo(map);
                }

                /* =========================================================
                   FUNÇÕES DE DISTÂNCIA
                ========================================================= */

                function metros(a, b) {

                    const R = 6371000;

                    const rad = Math.PI / 180;

                    const dLat =
                        (b[0] - a[0]) * rad;

                    const dLng =
                        (b[1] - a[1]) * rad;

                    const x =
                        Math.sin(dLat / 2) ** 2 +
                        Math.cos(a[0] * rad) *
                        Math.cos(b[0] * rad) *
                        Math.sin(dLng / 2) ** 2;

                    return 2 * R *
                        Math.asin(Math.sqrt(x));
                }

                function formatarDistancia(m) {

                    return m < 1000
                        ? Math.max(
                            10,
                            Math.round(m / 10) * 10
                        ) + ' m'
                        : (
                            m / 1000
                        ).toFixed(1)
                            .replace('.', ',') + ' km';
                }

                const norm = (t) =>
                    String(t || '')
                        .toLowerCase()
                        .normalize('NFD')
                        .replace(/[\u0300-\u036f]/g, '');

                /* =========================================================
                   ÍCONES
                ========================================================= */

                function ehMeuOnibus(bus) {

                    return (
                        tipoUsuario === 'MOTORISTA' &&
                        bus === onibus[0]
                    );
                }

                function criarIconeOnibus(numero, meu, alerta) {

                    let classe = '';

                    if (alerta) {
                        classe += ' alerta';

                        if (alerta.nivel === 'danger') {
                            classe += ' alerta-danger';
                        }
                    }

                    if (meu) {
                        classe += ' meu';
                    }

                    return L.divIcon({

                        className: '',

                        html: `
                            <div class="bus-pin ${classe}">
                                <i class="bi bi-bus-front-fill"></i>
                                ${numero}
                            </div>
                        `,

                        iconSize: [66, 30],

                        iconAnchor: [33, 15]

                    });
                }

                function criarIconePonto(qtd) {

                    return L.divIcon({

                        className: '',

                        html: `
                            <div class="ponto-pin">
                                ${qtd}
                            </div>
                        `,

                        iconSize: [30, 30],

                        iconAnchor: [15, 15]

                    });
                }

                const usuarioIcon = L.divIcon({

                    className: '',

                    html:
                        '<div class="usuario-marker"></div>',

                    iconSize: [30, 30],

                    iconAnchor: [15, 15]

                });

                /* =========================================================
                   LOCALIZAÇÃO
                ========================================================= */

                let marcadorUsuario = null;

                let posicaoUsuario = null;

                let centralizouUsuario = false;

                let watchId = null;

                function mostrarAviso(msg, tentarDeNovo) {

                    const el =
                        document.getElementById('aviso');

                    el.innerHTML =
                        '<span>' +
                        msg +
                        '</span>' +

                        (
                            tentarDeNovo
                                ? `
                                    <button
                                        type="button"
                                        onclick="obterLocalizacao()"
                                    >
                                        Tentar de novo
                                    </button>
                                `
                                : ''
                        );

                    el.style.display = 'flex';
                }

                function esconderAviso() {

                    document.getElementById(
                        'aviso'
                    ).style.display = 'none';
                }

                function mostrarUsuario(
                    latitude,
                    longitude
                ) {

                    posicaoUsuario = [
                        latitude,
                        longitude
                    ];

                    if (!marcadorUsuario) {

                        marcadorUsuario =
                            L.marker(
                                posicaoUsuario,
                                {
                                    icon: usuarioIcon
                                }
                            ).addTo(map);

                        marcadorUsuario.bindPopup(`
                            <div class="pp">
                                <h5>Você está aqui</h5>
                            </div>
                        `);

                    } else {

                        marcadorUsuario.setLatLng(
                            posicaoUsuario
                        );
                    }

                    if (!centralizouUsuario) {

                        centralizouUsuario = true;

                        map.flyTo(
                            posicaoUsuario,
                            16,
                            {
                                duration: 1
                            }
                        );
                    }

                    if (
                        tipoUsuario === 'MOTORISTA'
                    ) {

                        const el =
                            document.getElementById(
                                'localizacao-motorista'
                            );

                        if (el) {

                            el.textContent =
                                latitude.toFixed(5) +
                                ', ' +
                                longitude.toFixed(5);
                        }
                    }
                }

                function erroLocalizacao(err) {

                    let msg =
                        'Não foi possível obter sua localização.';

                    if (err.code === 1) {

                        msg =
                            'Permissão negada. Libere a localização para este site nas configurações do navegador.';

                    } else if (err.code === 2) {

                        msg =
                            'Sinal de GPS indisponível. Vá para um local aberto e tente de novo.';

                    } else if (err.code === 3) {

                        msg =
                            'A localização demorou demais para responder.';
                    }

                    mostrarAviso(
                        msg,
                        true
                    );
                }

                function obterLocalizacao() {

                    if (!navigator.geolocation) {

                        mostrarAviso(
                            'Este navegador não suporta localização.',
                            false
                        );

                        return;
                    }

                    if (!window.isSecureContext) {

                        mostrarAviso(
                            'O celular só libera a localização em site seguro. Abra o Bus Status por um link https://.',
                            false
                        );

                        return;
                    }

                    if (watchId !== null) {

                        navigator.geolocation.clearWatch(
                            watchId
                        );
                    }

                    esconderAviso();

                    watchId =
                        navigator.geolocation.watchPosition(

                            function (pos) {

                                esconderAviso();

                                mostrarUsuario(
                                    pos.coords.latitude,
                                    pos.coords.longitude
                                );
                            },

                            erroLocalizacao,

                            {
                                enableHighAccuracy: true,
                                timeout: 15000,
                                maximumAge: 5000
                            }

                        );
                }

                /* =========================================================
                   PONTOS
                ========================================================= */

                const pontosPassageiros = [

                    {
                        nome: "Ponto Centro - Santa Fé do Sul",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.2107305,
                        longitude: -50.9277761,
                        passageiros: 10
                    },

                    {
                        nome: "Ponto Rodoviária - Santa Fé do Sul",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.216631,
                        longitude: -50.9284286,
                        passageiros: 6
                    },

                    {
                        nome: "Ponto Universidade - Santa Fé do Sul",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.207547,
                        longitude: -50.923447,
                        passageiros: 14
                    },

                    {
                        nome: "Ponto Ginásio - Santa Fé do Sul",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.2137813,
                        longitude: -50.9248056,
                        passageiros: 8
                    },

                    {
                        nome: "Ponto Parque dos Sonhos - Santa Fé do Sul",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.2057675,
                        longitude: -50.9436502,
                        passageiros: 4
                    },

                    {
                        nome: "Ponto Vila Lobos",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.220267,
                        longitude: -50.9206438,
                        passageiros: 7
                    },

                    {
                        nome: "Ponto Avenida Navarro",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.205617,
                        longitude: -50.9264156,
                        passageiros: 5
                    },

                    {
                        nome: "Ponto L7 Escola de Artes",
                        cidade: "Santa Fé do Sul",
                        latitude: -20.2128224,
                        longitude: -50.9153505,
                        passageiros: 6
                    },

                    {
                        nome: "Ponto Centro - Rubinéia",
                        cidade: "Rubinéia",
                        latitude: -20.1763707,
                        longitude: -51.0075049,
                        passageiros: 9
                    },

                    {
                        nome: "Ponto Prefeitura - Rubinéia",
                        cidade: "Rubinéia",
                        latitude: -20.1712327,
                        longitude: -50.9983214,
                        passageiros: 5
                    },

                    {
                        nome: "Ponto Entrada - Rubinéia",
                        cidade: "Rubinéia",
                        latitude: -20.1742592,
                        longitude: -50.999771,
                        passageiros: 6
                    },

                    {
                        nome: "Ponto Prainha - Rubinéia",
                        cidade: "Rubinéia",
                        latitude: -20.1791407,
                        longitude: -51.0091061,
                        passageiros: 12
                    },

                    {
                        nome: "Ponto Creche São Judas - Três Fronteiras",
                        cidade: "Três Fronteiras",
                        latitude: -20.23436,
                        longitude: -50.89053,
                        passageiros: 8
                    },

                    {
                        nome: "Ponto Prefeitura - Três Fronteiras",
                        cidade: "Três Fronteiras",
                        latitude: -20.2327995,
                        longitude: -50.8850593,
                        passageiros: 5
                    },

                    {
                        nome: "Ponto ida para Santa Fé do Sul - Três Fronteiras",
                        cidade: "Três Fronteiras",
                        latitude: -20.2319673,
                        longitude: -50.8866722,
                        passageiros: 7
                    },

                    {
                        nome: "Ponto Residencial Santa Bárbara",
                        cidade: "Três Fronteiras",
                        latitude: -20.23180,
                        longitude: -50.89500,
                        passageiros: 4
                    }

                ];

                pontosPassageiros.forEach(
                    function (p, i) {
                        p.id = i;
                    }
                );

                const marcadoresPontos = [];

                pontosPassageiros.forEach(
                    function (ponto) {

                        const marker =
                            L.marker(
                                [
                                    ponto.latitude,
                                    ponto.longitude
                                ],
                                {
                                    icon:
                                        criarIconePonto(
                                            ponto.passageiros
                                        )
                                }
                            ).addTo(map);

                        marker.bindPopup(
                            function () {
                                return criarPopupPonto(
                                    ponto
                                );
                            }
                        );

                        marcadoresPontos.push({
                            marker: marker,
                            dados: ponto
                        });
                    }
                );

                /* =========================================================
                   ALERTAS SIMULADOS
                ========================================================= */

                const ALERTAS_SIMULADOS = [

                    {
                        tipo: 'Trânsito',
                        mensagem: 'Trânsito intenso no trajeto. A previsão pode sofrer pequeno atraso.',
                        nivel: 'warning',
                        icone: 'bi-cone-striped'
                    },

                    {
                        tipo: 'Atraso',
                        mensagem: 'Ônibus com atraso estimado de alguns minutos.',
                        nivel: 'warning',
                        icone: 'bi-clock-history'
                    },

                    {
                        tipo: 'Lotação',
                        mensagem: 'Alta demanda de passageiros neste ônibus.',
                        nivel: 'warning',
                        icone: 'bi-people-fill'
                    },

                    {
                        tipo: 'Informativo',
                        mensagem: 'Operação normal. Veículo seguindo para o próximo ponto.',
                        nivel: 'info',
                        icone: 'bi-info-circle-fill'
                    },

                    {
                        tipo: 'Atenção',
                        mensagem: 'Reduza a velocidade devido às condições do trajeto.',
                        nivel: 'danger',
                        icone: 'bi-exclamation-triangle-fill'
                    },

                    {
                        tipo: 'Informativo',
                        mensagem: 'Embarque sendo realizado no próximo ponto.',
                        nivel: 'info',
                        icone: 'bi-person-walking'
                    }

                ];

                /* =========================================================
                   ÔNIBUS
                ========================================================= */

                const INICIO_ONIBUS = [

                    [101, -20.2080, -50.9280, 0],

                    [102, -20.2140, -50.9220, 2],

                    [103, -20.2180, -50.9290, 3],

                    [104, -20.2040, -50.9200, 4],

                    [105, -20.2100, -50.9160, 5],

                    [106, -20.2020, -50.9250, 6],

                    [107, -20.1760, -51.0070, 7],

                    [108, -20.1730, -51.0035, 10],

                    [109, -20.2320, -50.8920, 11],

                    [110, -20.2260, -50.8980, 13],

                    [111, -20.2350, -50.8870, 12],

                    [112, -20.2150, -50.9300, 1]

                ];

                const onibus =
                    INICIO_ONIBUS.map(
                        function (d, indice) {

                            return {

                                numero: d[0],

                                latitude: d[1],

                                longitude: d[2],

                                destinoIndex: d[3],

                                rota: [],

                                indiceRota: 0,

                                distRestante: null,

                                espera: 0,

                                aCaminho: true,

                                versaoRota: 0,

                                marker: null,

                                alerta: null,

                                indiceAlerta: indice % ALERTAS_SIMULADOS.length
                            };
                        }
                    );

                /* =========================================================
                   ATUALIZAR ALERTAS SIMULADOS
                ========================================================= */

                function atualizarAlertasSimulados() {

                    const ciclo =
                        Math.floor(
                            Date.now() / 12000
                        );

                    onibus.forEach(
                        function (bus, indice) {

                            /*
                             * Alguns ônibus ficam sem alerta,
                             * enquanto outros recebem alertas.
                             *
                             * Isso deixa o mapa mais realista.
                             */

                            const deveTerAlerta =
                                (
                                    (ciclo + indice) % 4 !== 0
                                );

                            if (!deveTerAlerta) {

                                bus.alerta = null;

                            } else {

                                const posicao =
                                    (
                                        ciclo +
                                        indice
                                    ) %
                                    ALERTAS_SIMULADOS.length;

                                bus.alerta =
                                    ALERTAS_SIMULADOS[
                                        posicao
                                    ];
                            }

                            if (bus.marker) {

                                bus.marker.setIcon(
                                    criarIconeOnibus(
                                        bus.numero,
                                        ehMeuOnibus(bus),
                                        bus.alerta
                                    )
                                );
                            }
                        }
                    );
                }

                const marcadoresOnibus = [];

                onibus.forEach(
                    function (bus) {

                        bus.marker =
                            L.marker(
                                [
                                    bus.latitude,
                                    bus.longitude
                                ],
                                {
                                    icon:
                                        criarIconeOnibus(
                                            bus.numero,
                                            ehMeuOnibus(bus),
                                            bus.alerta
                                        ),

                                    zIndexOffset:
                                        ehMeuOnibus(bus)
                                            ? 1000
                                            : 0
                                }
                            ).addTo(map);

                        bus.marker.bindPopup(
                            function () {
                                return criarPopupOnibus(
                                    bus
                                );
                            }
                        );

                        marcadoresOnibus.push({
                            marker: bus.marker,
                            dados: bus
                        });
                    }
                );

                atualizarAlertasSimulados();

                /* =========================================================
                   DESTINO E ETA
                ========================================================= */

                function obterDestino(bus) {

                    return pontosPassageiros[
                        bus.destinoIndex
                    ];
                }

                function distRestanteDoOnibus(bus) {

                    if (bus.distRestante !== null) {
                        return bus.distRestante;
                    }

                    const d =
                        obterDestino(bus);

                    return metros(
                        [
                            bus.latitude,
                            bus.longitude
                        ],
                        [
                            d.latitude,
                            d.longitude
                        ]
                    ) * FATOR_RUA;
                }

                function segundosAtePonto(
                    bus,
                    idxPonto
                ) {

                    const n =
                        pontosPassageiros.length;

                    let seg =
                        bus.espera > 0
                            ? 0
                            :
                            distRestanteDoOnibus(bus) /
                            VELOCIDADE_ONIBUS;

                    let atual =
                        bus.destinoIndex;

                    let passos = 0;

                    while (
                        atual !== idxPonto &&
                        passos < n
                    ) {

                        const prox =
                            (atual + 1) % n;

                        const a =
                            pontosPassageiros[atual];

                        const b =
                            pontosPassageiros[prox];

                        seg +=
                            (
                                atual ===
                                bus.destinoIndex &&
                                bus.espera > 0
                            )
                                ? bus.espera
                                : TEMPO_PARADA;

                        seg +=
                            metros(
                                [
                                    a.latitude,
                                    a.longitude
                                ],
                                [
                                    b.latitude,
                                    b.longitude
                                ]
                            ) *
                            FATOR_RUA /
                            VELOCIDADE_ONIBUS;

                        atual = prox;

                        passos++;
                    }

                    return seg;
                }

                function infoETA(
                    seg,
                    noPonto
                ) {

                    if (noPonto) {

                        return {
                            t: 'No ponto',
                            c: 'eta-agora'
                        };
                    }

                    if (seg <= 45) {

                        return {
                            t: 'Chegando',
                            c: 'eta-agora'
                        };
                    }

                    const min =
                        Math.ceil(seg / 60);

                    return {
                        t: min + ' min',
                        c:
                            min <= 5
                                ? 'eta-perto'
                                : ''
                    };
                }

                function etaDoPonto(p) {

                    let melhor = null;

                    let menor = Infinity;

                    onibus.forEach(
                        function (b) {

                            const s =
                                segundosAtePonto(
                                    b,
                                    p.id
                                );

                            if (s < menor) {

                                menor = s;

                                melhor = b;
                            }
                        }
                    );

                    if (!melhor) {
                        return null;
                    }

                    return {

                        bus: melhor,

                        seg: menor,

                        info:
                            infoETA(
                                menor,
                                melhor.espera > 0 &&
                                melhor.destinoIndex === p.id
                            )
                    };
                }

                function nomeCurto(p) {

                    return p.nome
                        .replace(
                            /^Ponto\s+/i,
                            ''
                        )
                        .replace(
                            new RegExp(
                                '\\s*-\\s*' +
                                p.cidade +
                                '$'
                            ),
                            ''
                        );
                }

                /* =========================================================
