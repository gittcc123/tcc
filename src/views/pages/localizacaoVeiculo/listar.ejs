<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

<head>

    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">

    <style>
        :root {
            --v: #7a1f1f;
            --v-dark: #641919;
            --v-light: #f8e9e9;
            --tx: #1f2933;
            --mut: #6b7280;
            --bd: #e5e7eb;
            --bg: #f4f6f9;
            --warning: #d97706;
            --warning-bg: #fff7ed;
            --danger: #dc2626;
            --danger-bg: #fef2f2;
            --success: #15803d;
            --success-bg: #dcfce7;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            background: var(--bg);
            color: var(--tx);
            overflow-x: hidden;
        }

        .content {
            padding: 0;
            width: 100%;
            min-width: 0;
        }

        .mapa-area {
            position: relative;
            width: 100%;
            height: 80vh;
            overflow: hidden;
            background: #e5e7eb;
        }

        #map {
            width: 100%;
            height: 100%;
        }

        /* =========================================================
           PAINEL
        ========================================================= */

        .sheet {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1000;
            height: 45%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #f6f7f9;
            border-radius: 26px 26px 0 0;
            box-shadow: 0 -8px 32px rgba(15, 23, 42, .22);
            padding-bottom: env(safe-area-inset-bottom);
        }

        .sheet-topo {
            flex: none;
            padding: 10px 18px 14px;
            background: #fff;
            border-bottom: 1px solid #eceff3;
            touch-action: none;
            cursor: grab;
            user-select: none;
        }

        .sheet-topo:active {
            cursor: grabbing;
        }

        .sheet-handle {
            width: 42px;
            height: 5px;
            border-radius: 3px;
            background: #cfd4dc;
            margin: 0 auto 10px;
        }

        .sheet-topo h1 {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -.3px;
            margin: 8px 0 0;
            color: var(--tx);
        }

        .sheet-topo p {
            margin: 2px 0 0;
            font-size: 13px;
            color: var(--mut);
        }

        .sheet-corpo {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            overscroll-behavior: contain;
            padding: 14px 14px 22px;
            -webkit-overflow-scrolling: touch;
        }

        /* =========================================================
           STATUS AO VIVO
        ========================================================= */

        .live {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            color: var(--success);
            background: var(--success-bg);
            padding: 4px 10px;
            border-radius: 20px;
        }

        .live .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #16a34a;
            animation: pulso 1.6s infinite;
        }

        .live-mot {
            color: #fbbf24;
            background: rgba(251, 191, 36, .16);
        }

        @keyframes pulso {
            0% {
                box-shadow: 0 0 0 0 rgba(22, 163, 74, .55);
            }

            100% {
                box-shadow: 0 0 0 8px rgba(22, 163, 74, 0);
            }
        }

        /* =========================================================
           BUSCA
        ========================================================= */

        .busca {
            position: relative;
            margin-bottom: 10px;
        }

        .busca i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--mut);
            pointer-events: none;
        }

        .busca input {
            width: 100%;
            border: 1px solid var(--bd);
            background: #fff;
            border-radius: 12px;
            padding: 13px 14px 13px 40px;
            font-size: 16px;
            outline: none;
            box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
        }

        .busca input:focus {
            border-color: var(--v);
            box-shadow: 0 0 0 3px rgba(122, 31, 31, .10);
        }

        /* =========================================================
           ABAS
        ========================================================= */

        .abas {
            display: flex;
            background: #e6e9ee;
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 10px;
        }

        .abas button {
            flex: 1;
            border: 0;
            background: transparent;
            padding: 9px 4px;
            border-radius: 9px;
            font-weight: 600;
            font-size: 14px;
            color: var(--mut);
            cursor: pointer;
            transition: .18s ease;
        }

        .abas button:hover {
            color: var(--v);
        }

        .abas button.ativa {
            background: #fff;
            color: var(--v);
            box-shadow: 0 1px 4px rgba(0, 0, 0, .12);
        }

        /* =========================================================
           CIDADES - ROLAGEM HORIZONTAL
        ========================================================= */

        .chips-wrapper {
            position: relative;
            margin-bottom: 8px;
        }

        .chips {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 2px 2px 12px;
            scrollbar-width: thin;
            scrollbar-color: #c5c9d0 transparent;
            cursor: grab;
            user-select: none;
            -webkit-overflow-scrolling: touch;
            touch-action: pan-x;
        }

        .chips.arrastando {
            cursor: grabbing;
        }

        .chips::-webkit-scrollbar {
            height: 5px;
        }

        .chips::-webkit-scrollbar-track {
            background: transparent;
        }

        .chips::-webkit-scrollbar-thumb {
            background: #c5c9d0;
            border-radius: 10px;
        }

        .chips::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .chips button {
            flex: none;
            border: 1px solid var(--bd);
            background: #fff;
            border-radius: 20px;
            padding: 7px 14px;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
            box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
            cursor: pointer;
            white-space: nowrap;
            transition: .15s ease;
        }

        .chips button:hover {
            border-color: #c7cbd1;
        }

        .chips button.ativa {
            background: var(--v);
            border-color: var(--v);
            color: #fff;
        }

        /* =========================================================
           ITENS
        ========================================================= */

        .item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #fff;
            border: 1px solid #eceff3;
            border-radius: 16px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: transform .12s, border-color .12s, background .12s;
        }

        .item:hover {
            border-color: #d5d9df;
        }

        .item:active {
            transform: scale(.985);
        }

        .item.ativo {
            border-color: var(--v);
            background: #fdf4f4;
        }

        .item-ico {
            flex: none;
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 15px;
            background: #fef3c7;
            color: #b45309;
        }

        .item-ico.bus {
            background: var(--v);
            color: #fff;
            font-size: 13px;
        }

        .item-ico.rota {
            background: var(--v-light);
            color: var(--v);
            font-size: 19px;
        }

        .item-info {
            flex: 1;
            min-width: 0;
        }

        .item-info strong {
            display: block;
            font-size: 15px;
            color: var(--tx);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .item-info span {
            display: block;
            font-size: 12.5px;
            color: var(--mut);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 2px;
        }

        .item-go {
            flex: none;
            color: #9ca3af;
            font-size: 16px;
        }

        .item.ativo .item-go {
            color: var(--v);
        }

        .vazio {
            padding: 22px 10px;
            text-align: center;
            color: var(--mut);
            font-size: 14px;
        }

        /* =========================================================
           ETA
        ========================================================= */

        .eta {
            flex: none;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            background: #f3f4f6;
            color: #4b5563;
            white-space: nowrap;
        }

        .eta-agora {
            background: var(--success-bg);
            color: var(--success);
        }

        .eta-perto {
            background: #fef3c7;
            color: #b45309;
        }

        /* =========================================================
           ALERTAS DOS ÔNIBUS
        ========================================================= */

        .bus-alerta {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 5px;
            color: #b45309 !important;
            font-size: 11.5px !important;
            font-weight: 700;
        }

        .bus-alerta i {
            font-size: 12px;
        }

        .bus-alerta.alto {
            color: #dc2626 !important;
        }

        .bus-alerta.info {
            color: #2563eb !important;
        }

        .alerta-card {
            display: flex;
            gap: 10px;
            margin-top: 10px;
            padding: 10px;
            border-radius: 11px;
            background: var(--warning-bg);
            border: 1px solid #fed7aa;
        }

        .alerta-card.danger {
            background: var(--danger-bg);
            border-color: #fecaca;
        }

        .alerta-card.info {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .alerta-card-icone {
            flex: none;
            width: 30px;
            height: 30px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fed7aa;
            color: #b45309;
        }

        .alerta-card.danger .alerta-card-icone {
            background: #fecaca;
            color: #dc2626;
        }

        .alerta-card.info .alerta-card-icone {
            background: #bfdbfe;
            color: #2563eb;
        }

        .alerta-card-info {
            min-width: 0;
        }

        .alerta-card-info strong {
            display: block;
            font-size: 12px;
            margin-bottom: 2px;
        }

        .alerta-card-info span {
            display: block;
            font-size: 12px;
            color: #6b7280;
            line-height: 1.35;
        }

        /* =========================================================
           RESUMO ADMIN
        ========================================================= */

        .resumo {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }

        .resumo > div {
            flex: 1;
            background: #fff;
            border: 1px solid #eceff3;
            border-radius: 14px;
            padding: 10px;
            text-align: center;
        }

        .resumo strong {
            display: block;
            font-size: 22px;
            color: var(--v);
        }

        .resumo small {
            color: var(--mut);
        }

        /* =========================================================
           FAB
        ========================================================= */

        .fabs {
            position: absolute;
            right: 12px;
            bottom: calc(var(--sh, 300px) + 14px);
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .fab {
            width: 48px;
            height: 48px;
            border: 0;
            border-radius: 50%;
            background: #fff;
            color: var(--v);
            font-size: 19px;
            box-shadow: 0 3px 14px rgba(0, 0, 0, .25);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .fab:active {
            background: #f3f4f6;
        }

        .btn-voltar-mapa {
            border-radius: 12px;
            font-weight: 600;
            border: 0;
            box-shadow: 0 3px 14px rgba(0, 0, 0, .20);
        }

        /* =========================================================
           MARCADORES
        ========================================================= */

        .bus-pin {
            width: 66px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            border-radius: 15px;
            background: linear-gradient(135deg, #9b2a2a, #6a1818);
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            border: 2px solid #fff;
            box-shadow: 0 3px 10px rgba(0, 0, 0, .35);
            box-sizing: border-box;
            white-space: nowrap;
        }

        .bus-pin.meu {
            background: #f59e0b;
            color: #1f2933;
            border-color: #1f2933;
            transform: scale(1.2);
        }

        .bus-pin.alerta {
            box-shadow:
                0 0 0 3px rgba(217, 119, 6, .30),
                0 3px 10px rgba(0, 0, 0, .35);
        }

        .bus-pin.alerta-danger {
            box-shadow:
                0 0 0 3px rgba(220, 38, 38, .35),
                0 3px 10px rgba(0, 0, 0, .35);
        }

        .modo-motorista .bus-pin:not(.meu) {
            opacity: .45;
        }

        .ponto-pin {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid #f59e0b;
            color: var(--tx);
            font-weight: 700;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .3);
            box-sizing: border-box;
        }

        .parada-pin {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--v);
            color: #fff;
            border: 3px solid #fff;
            font-weight: 700;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .4);
        }

        .usuario-marker {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #2563eb;
            border: 4px solid #fff;
            box-sizing: border-box;
            box-shadow:
                0 0 0 6px rgba(37, 99, 235, .25),
                0 2px 8px rgba(0, 0, 0, .3);
            animation: pulsoAzul 2s infinite;
        }

        @keyframes pulsoAzul {
            0% {
                box-shadow:
                    0 0 0 0 rgba(37, 99, 235, .5),
                    0 2px 8px rgba(0, 0, 0, .3);
            }

            100% {
                box-shadow:
                    0 0 0 16px rgba(37, 99, 235, 0),
                    0 2px 8px rgba(0, 0, 0, .3);
            }
        }

        /* =========================================================
           POPUP
        ========================================================= */

        .leaflet-popup-content-wrapper {
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .25);
        }

        .leaflet-popup-content {
            margin: 14px 16px;
        }

        .pp h5 {
            margin: 0 0 2px;
            font-size: 16px;
            font-weight: 700;
            color: var(--v);
        }

        .pp small {
            color: var(--mut);
        }

        .pp p {
            margin: 8px 0 0;
            font-size: 14px;
        }

        .eta-card {
            margin-top: 10px;
            padding: 10px;
            border-radius: 10px;
            background: #f6f6f6;
            font-size: 13px;
        }

        /* =========================================================
           AVISO
        ========================================================= */

        .aviso {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            z-index: 999;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            background: #fff;
            border-left: 5px solid var(--v);
            border-radius: 12px;
            box-shadow: 0 3px 14px rgba(0, 0, 0, .25);
            font-size: 14px;
            color: var(--tx);
        }

        .aviso span {
            flex: 1;
        }

        .aviso button {
            flex: none;
            border: 0;
            background: var(--v);
            color: #fff;
            border-radius: 8px;
            padding: 7px 12px;
            font-weight: 600;
            font-size: 13px;
        }

        /* =========================================================
           BANNER DA ROTA
        ========================================================= */

        .rota-banner {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            z-index: 999;
            display: none;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            background: var(--v);
            color: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .3);
        }

        .rb-ico {
            flex: none;
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: rgba(255, 255, 255, .18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .rb-info {
            flex: 1;
            min-width: 0;
        }

        .rb-info strong {
            display: block;
            font-size: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .rb-info span {
            display: block;
            font-size: 12.5px;
            opacity: .85;
        }

        .rota-banner button {
            flex: none;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, .2);
            color: #fff;
        }

        .com-rota .aviso {
            top: 76px;
        }

        /* =========================================================
           MOTORISTA
        ========================================================= */

        .sheet-mot {
            background: #f3f4f6;
        }

        .sheet-mot .sheet-topo {
            background: #1f2933;
            border-bottom-color: #374151;
        }

        .sheet-mot .sheet-topo h1 {
            color: #fff;
        }

        .sheet-mot .sheet-topo p {
            color: #9ca3af;
        }

        .sheet-mot .sheet-handle {
            background: #4b5563;
        }

        .modo-motorista [data-aba="onibus"] {
            display: none;
        }

        .mot-hero {
            background: linear-gradient(145deg, #1f2933, #3b4654);
            color: #fff;
            border-radius: 22px;
            padding: 16px;
            margin-bottom: 14px;
            box-shadow: 0 6px 18px rgba(31, 41, 51, .35);
        }

        .mot-topo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .mot-bus {
            font-weight: 800;
            font-size: 15px;
            background: #f59e0b;
            color: #1f2933;
            padding: 4px 12px;
            border-radius: 20px;
        }

        .mot-status {
            font-size: 13px;
            font-weight: 700;
            color: #bbf7d0;
        }

        .mot-rot {
            color: #9ca3af;
            font-size: 12px;
        }

        .mot-ponto {
            font-size: 19px;
            font-weight: 700;
            line-height: 1.25;
            margin: 2px 0 10px;
        }

        .mot-eta-linha {
            display: flex;
            align-items: baseline;
            gap: 10px;
            margin-bottom: 14px;
        }

        .mot-eta-linha strong {
            font-size: 40px;
            font-weight: 800;
            color: #fbbf24;
            line-height: 1;
        }

        .mot-eta-linha span {
            color: #cbd5e1;
            font-size: 13px;
        }

        .mot-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .mot-grid > div {
            background: rgba(255, 255, 255, .08);
            border-radius: 14px;
            padding: 10px;
            min-width: 0;
        }

        .mot-grid b {
            display: block;
            font-size: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mot-grid small {
            color: #9ca3af;
            font-size: 12px;
        }

        .mot-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #f59e0b;
            color: #1f2933;
            font-weight: 700;
            border-radius: 14px;
            padding: 12px;
            text-decoration: none;
        }

        /* =========================================================
           DESKTOP
        ========================================================= */

        @media (min-width: 992px) {

            .sheet {
                left: 16px;
                top: 16px;
                bottom: 16px;
                right: auto;
                width: 380px;
                height: auto !important;
                border-radius: 20px;
                box-shadow: 0 8px 30px rgba(0, 0, 0, .22);
            }

            .sheet-topo {
                cursor: default;
                touch-action: auto;
            }

            .sheet-handle {
                display: none;
            }

            .fabs {
                bottom: 24px !important;
            }

            .aviso {
                left: 412px;
                right: 72px;
            }

            .rota-banner {
                left: 412px;
                right: 72px;
            }

            .com-rota .aviso {
                left: 412px;
            }
        }

        @media (max-width: 600px) {

            .mapa-area {
                min-height: 500px;
            }

            .sheet-topo {
                padding-left: 15px;
                padding-right: 15px;
            }

            .sheet-corpo {
                padding-left: 12px;
                padding-right: 12px;
            }

            .fabs {
                right: 10px;
            }

            .btn-voltar-mapa {
                padding: 8px 12px !important;
                font-size: 12px;
            }

            .item {
                padding: 11px;
            }

            .item-ico {
                width: 40px;
                height: 40px;
            }

            .eta {
                font-size: 12px;
                padding: 5px 8px;
            }
        }
    </style>

</head>

<body>

    <%- include('../../partials/header') %>

        <%
            const ehMotorista =
                typeof usuario !== 'undefined' &&
                usuario &&
                usuario.tipo === 'MOTORISTA';
        %>

        <div class="d-flex">

            <%- include('../../partials/sidebar') %>

                <main class="content">

                    <div
                        class="mapa-area <%= ehMotorista ? 'modo-motorista' : '' %>"
                        id="mapa-area"
                    >

                        <div id="map"></div>

                        <div
                            class="aviso"
                            id="aviso"
                            style="display:none"
                        ></div>

                        <div
                            class="rota-banner"
                            id="rota-banner"
                        >
                            <div class="rb-ico">
                                <i class="bi bi-signpost-split"></i>
                            </div>

