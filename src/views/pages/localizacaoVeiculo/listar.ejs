                /* =========================================================
                   ROTAS DOS ÔNIBUS
                ========================================================= */

                async function calcularRota(bus) {

                    const destino =
                        obterDestino(bus);

                    const versao =
                        ++bus.versaoRota;

                    try {

                        const url =
                            'https://router.project-osrm.org/route/v1/driving/' +
                            bus.longitude +
                            ',' +
                            bus.latitude +
                            ';' +
                            destino.longitude +
                            ',' +
                            destino.latitude +
                            '?overview=full&geometries=geojson';

                        const resposta =
                            await fetch(url);

                        if (!resposta.ok) {

                            throw new Error(
                                'Erro no serviço de rotas'
                            );
                        }

                        const dados =
                            await resposta.json();

                        if (
                            !dados.routes ||
                            !dados.routes.length
                        ) {

                            throw new Error(
                                'Nenhuma rota encontrada'
                            );
                        }

                        if (
                            versao !== bus.versaoRota ||
                            !bus.aCaminho
                        ) {
                            return;
                        }

                        bus.rota =
                            dados.routes[0]
                                .geometry
                                .coordinates
                                .map(
                                    c => [
                                        c[1],
                                        c[0]
                                    ]
                                );

                        bus.indiceRota = 0;

                        bus.distRestante =
                            dados.routes[0].distance;

                    } catch (erro) {

                        console.error(
                            'Erro ao calcular rota do ônibus',
                            bus.numero,
                            erro
                        );

                        if (
                            versao !== bus.versaoRota ||
                            !bus.aCaminho
                        ) {
                            return;
                        }

                        bus.rota = [
                            [
                                destino.latitude,
                                destino.longitude
                            ]
                        ];

                        bus.indiceRota = 0;

                        bus.distRestante =
                            metros(
                                [
                                    bus.latitude,
                                    bus.longitude
                                ],
                                [
                                    destino.latitude,
                                    destino.longitude
                                ]
                            );

                        setTimeout(
                            function () {

                                if (
                                    versao ===
                                    bus.versaoRota &&
                                    bus.aCaminho
                                ) {

                                    calcularRota(bus);
                                }
                            },
                            8000
                        );
                    }
                }

                function iniciarViagem(bus) {

                    bus.destinoIndex =
                        (
                            bus.destinoIndex + 1
                        ) %
                        pontosPassageiros.length;

                    bus.distRestante = null;

                    bus.rota = [];

                    bus.indiceRota = 0;

                    bus.aCaminho = true;

                    calcularRota(bus);
                }

                function moverOnibus(
                    bus,
                    dt
                ) {

                    if (bus.espera > 0) {

                        bus.espera -= dt;

                        if (bus.espera <= 0) {

                            bus.espera = 0;

                            iniciarViagem(bus);
                        }

                        return;
                    }

                    if (!bus.rota.length) {
                        return;
                    }

                    let passo =
                        VELOCIDADE_ONIBUS * dt;

                    while (
                        passo > 0 &&
                        bus.indiceRota <
                        bus.rota.length
                    ) {

                        const alvo =
                            bus.rota[
                                bus.indiceRota
                            ];

                        const d =
                            metros(
                                [
                                    bus.latitude,
                                    bus.longitude
                                ],
                                alvo
                            );

                        if (d <= passo) {

                            bus.latitude =
                                alvo[0];

                            bus.longitude =
                                alvo[1];

                            bus.indiceRota++;

                            passo -= d;

                            bus.distRestante =
                                Math.max(
                                    0,
                                    bus.distRestante - d
                                );

                        } else {

                            const f =
                                passo / d;

                            bus.latitude +=
                                (
                                    alvo[0] -
                                    bus.latitude
                                ) * f;

                            bus.longitude +=
                                (
                                    alvo[1] -
                                    bus.longitude
                                ) * f;

                            bus.distRestante =
                                Math.max(
                                    0,
                                    bus.distRestante - passo
                                );

                            passo = 0;
                        }
                    }

                    if (
                        bus.indiceRota >=
                        bus.rota.length
                    ) {

                        const destino =
                            obterDestino(bus);

                        bus.latitude =
                            destino.latitude;

                        bus.longitude =
                            destino.longitude;

                        bus.rota = [];

                        bus.distRestante = 0;

                        bus.aCaminho = false;

                        bus.espera =
                            TEMPO_PARADA;
                    }

                    bus.marker.setLatLng(
                        [
                            bus.latitude,
                            bus.longitude
                        ]
                    );
                }

                /* =========================================================
                   RENDERIZAÇÃO
                ========================================================= */

                function definirHTML(
                    id,
                    html
                ) {

                    if (
                        cacheHTML[id] !== html
                    ) {

                        cacheHTML[id] = html;

                        document.getElementById(
                            id
                        ).innerHTML = html;
                    }
                }

                function renderizarListas() {

                    const q =
                        norm(termoBusca);

                    const cidades =
                        ['Todas'].concat(
                            Array.from(
                                new Set(
                                    pontosPassageiros.map(
                                        p => p.cidade
                                    )
                                )
                            )
                        );

                    definirHTML(
                        'chips-cidades',

                        cidades.map(
                            c => `
                                <button
                                    type="button"
                                    class="${c === cidadeAtual ? 'ativa' : ''}"
                                    data-cidade="${c}"
                                >
                                    ${c}
                                </button>
                            `
                        ).join('')
                    );

                    /* =========================
                       PONTOS
                    ========================= */

                    const pts =
                        pontosPassageiros

                            .map(
                                p => ({

                                    p: p,

                                    r:
                                        etaDoPonto(p),

                                    du:
                                        posicaoUsuario
                                            ? metros(
                                                posicaoUsuario,
                                                [
                                                    p.latitude,
                                                    p.longitude
                                                ]
                                            )
                                            : null

                                })
                            )

                            .filter(
                                x =>

                                    (
                                        cidadeAtual ===
                                        'Todas' ||
                                        x.p.cidade ===
                                        cidadeAtual
                                    )

                                    &&

                                    norm(
                                        x.p.nome +
                                        ' ' +
                                        x.p.cidade
                                    ).includes(q)
                            )

                            .sort(
                                (a, b) =>

                                    posicaoUsuario

                                        ? a.du - b.du

                                        :

                                        (
                                            a.r
                                                ? a.r.seg
                                                : 1e9
                                        )

                                        -

                                        (
                                            b.r
                                                ? b.r.seg
                                                : 1e9
                                        )
                            );

                    definirHTML(
                        'lista-pontos',

                        pts.length

                            ?

                            pts.map(
                                x => `

                                    <div
                                        class="item"
                                        data-ponto="${x.p.id}"
                                    >

                                        <div class="item-ico">
                                            ${x.p.passageiros}
                                        </div>

                                        <div class="item-info">

                                            <strong>
                                                ${nomeCurto(x.p)}
                                            </strong>

                                            <span>
                                                ${
                                                    x.du !== null
                                                        ? formatarDistancia(x.du) +
                                                          ' de você · '
                                                        : ''
                                                }

                                                ${x.p.passageiros}
                                                aguardando
                                            </span>

                                            <span>
                                                ${
                                                    x.r
                                                        ? 'Ônibus ' +
                                                          x.r.bus.numero
                                                        : 'Nenhum ônibus previsto'
                                                }
                                            </span>

                                        </div>

                                        <div
                                            class="eta ${
                                                x.r
                                                    ? x.r.info.c
                                                    : ''
                                            }"
                                        >
                                            ${
                                                x.r
                                                    ? x.r.info.t
                                                    : '--'
                                            }
                                        </div>

                                    </div>

                                `
                            ).join('')

                            :

                            `
                                <div class="vazio">
                                    Nenhum ponto encontrado.
                                </div>
                            `
                    );

                    /* =========================
                       ÔNIBUS
                    ========================= */

                    const bs =
                        onibus

                            .map(
                                b => ({

                                    b: b,

                                    d:
                                        obterDestino(b),

                                    seg:
                                        segundosAtePonto(
                                            b,
                                            b.destinoIndex
                                        )
                                })
                            )

                            .filter(
                                x =>

                                    (
                                        cidadeAtual ===
                                        'Todas' ||

                                        x.d.cidade ===
                                        cidadeAtual
                                    )

                                    &&

                                    norm(
                                        'onibus ' +
                                        x.b.numero +
                                        ' ' +
                                        x.d.nome
                                    ).includes(q)
                            )

                            .sort(
                                (a, b) =>
                                    a.seg - b.seg
                            );

                    definirHTML(
                        'lista-onibus',

                        bs.length

                            ?

                            bs.map(
                                x => {

                                    const parado =
                                        x.b.espera > 0;

                                    const e =
                                        infoETA(
                                            x.seg,
                                            parado
                                        );

                                    let alertaHTML =
                                        '';

                                    if (
                                        x.b.alerta
                                    ) {

                                        let classe =
                                            '';

                                        if (
                                            x.b.alerta.nivel ===
                                            'danger'
                                        ) {
                                            classe =
                                                'alto';
                                        }

                                        if (
                                            x.b.alerta.nivel ===
                                            'info'
                                        ) {
                                            classe =
                                                'info';
                                        }

                                        alertaHTML = `
                                            <span
                                                class="bus-alerta ${classe}"
                                            >
                                                <i
                                                    class="bi ${x.b.alerta.icone}"
                                                ></i>

                                                ${x.b.alerta.tipo}
                                            </span>
                                        `;
                                    }

                                    return `

                                        <div
                                            class="item"
                                            data-onibus="${x.b.numero}"
                                        >

                                            <div class="item-ico bus">
                                                ${x.b.numero}
                                            </div>

                                            <div class="item-info">

                                                <strong>
                                                    Indo para
                                                    ${nomeCurto(x.d)}
                                                </strong>

                                                <span>
                                                    ${
                                                        parado
                                                            ? 'Parado no ponto'
                                                            :
                                                            'a ' +
                                                            formatarDistancia(
                                                                distRestanteDoOnibus(
                                                                    x.b
                                                                )
                                                            ) +
                                                            ' do ponto'
                                                    }
                                                </span>

                                                ${alertaHTML}

                                            </div>

                                            <div
                                                class="eta ${e.c}"
                                            >
                                                ${e.t}
                                            </div>

                                        </div>

                                    `;
                                }
                            ).join('')

                            :

                            `
                                <div class="vazio">
                                    Nenhum ônibus encontrado.
                                </div>
                            `
                    );

                    /* =========================
                       ROTAS
                    ========================= */

                    const rs =
                        rotas

                            .map(
                                function (r, i) {

                                    return {
                                        r: r,
                                        i: i
                                    };
                                }
                            )

                            .filter(
                                x =>
                                    norm(
                                        x.r.descricao
                                    ).includes(q)
                            );

                    definirHTML(
                        'lista-rotas',

                        rs.length

                            ?

                            rs.map(
                                x => `

                                    <div
                                        class="item ${
                                            x.i === rotaAtiva
                                                ? 'ativo'
                                                : ''
                                        }"
                                        data-rota="${x.i}"
                                    >

                                        <div class="item-ico rota">

                                            <i
                                                class="bi bi-signpost-split"
                                            ></i>

                                        </div>

                                        <div class="item-info">

                                            <strong>
                                                ${x.r.descricao}
                                            </strong>

                                            <span>
                                                Tempo médio:
                                                ${x.r.tempo_medio}
                                                minutos
                                            </span>

                                        </div>

                                        <div class="item-go">

                                            <i
                                                class="bi ${
                                                    x.i === rotaAtiva
                                                        ? 'bi-eye-fill'
                                                        : 'bi-chevron-right'
                                                }"
                                            ></i>

                                        </div>

                                    </div>

                                `
                            ).join('')

                            :

                            `
                                <div class="vazio">
                                    Nenhuma rota cadastrada.
                                </div>
                            `
                    );
                }

                /* =========================================================
                   MOTORISTA
                ========================================================= */

                let linhaMotorista = null;

                function atualizarMotorista() {

                    if (
                        tipoUsuario !==
                        'MOTORISTA'
                    ) {
                        return;
                    }

                    const bus =
                        onibus[0];

                    const parado =
                        bus.espera > 0;

                    const d =
                        obterDestino(bus);

                    const e =
                        infoETA(
                            segundosAtePonto(
                                bus,
                                bus.destinoIndex
                            ),
                            parado
                        );

                    const set =
                        function (
                            id,
                            txt
                        ) {

                            const el =
                                document.getElementById(
                                    id
                                );

                            if (el) {
                                el.textContent =
                                    txt;
                            }
                        };

                    set(
                        'numero-motorista',
                        'Ônibus ' +
                        bus.numero
                    );

                    set(
                        'status-motorista',
                        parado
                            ? 'Parado no ponto'
                            : 'Em operação'
                    );

                    set(
                        'proximo-ponto-motorista',
                        nomeCurto(d) +
                        ' · ' +
                        d.cidade
                    );

                    set(
                        'eta-motorista',
                        e.t
                    );

                    set(
                        'dist-motorista',

                        parado
                            ? 'embarque em andamento'
                            :
                            'faltam ' +
                            formatarDistancia(
                                distRestanteDoOnibus(
                                    bus
                                )
                            )
                    );

                    set(
                        'aguardando-motorista',
                        d.passageiros
                    );

                    if (!linhaMotorista) {

                        linhaMotorista =
                            L.polyline(
                                [],
                                {
                                    color: '#f59e0b',
                                    weight: 6,
                                    opacity: .9
                                }
                            ).addTo(map);
                    }

                    linhaMotorista.setLatLngs(

                        bus.rota.length

                            ?

                            [
                                [
                                    bus.latitude,
                                    bus.longitude
                                ]
                            ].concat(
                                bus.rota.slice(
                                    bus.indiceRota
                                )
                            )

                            :

                            []
                    );
                }

                /* =========================================================
                   CONTADORES
                ========================================================= */

                if (
                    tipoUsuario ===
                    'ADMIN'
                ) {

                    const co =
                        document.getElementById(
                            'contador-onibus'
                        );

                    const cp =
                        document.getElementById(
                            'contador-pontos'
                        );

                    if (co) {
                        co.textContent =
                            onibus.length;
                    }

                    if (cp) {
                        cp.textContent =
                            pontosPassageiros.length;
                    }
                }

                function atualizarInterface() {

                    renderizarListas();

                    atualizarPopups();

                    atualizarMotorista();
                }

                /* =========================================================
                   ROTAS NO MAPA
                ========================================================= */

                let camadaRota = null;

                let tokenRota = 0;

                function pontosDaRota(r) {

                    const desc =
                        norm(r.descricao);

                    const cidades =
                        Array.from(
                            new Set(
                                pontosPassageiros.map(
                                    p => p.cidade
                                )
                            )
                        )

                        .map(
                            c => ({
                                c: c,
                                i: desc.indexOf(
                                    norm(c)
                                )
                            })
                        )

                        .filter(
                            x => x.i >= 0
                        )

                        .sort(
                            (a, b) =>
                                a.i - b.i
                        )

                        .map(
                            x => x.c
                        );

                    let lista = [];

                    cidades.forEach(
                        function (c) {

                            lista =
                                lista.concat(
                                    pontosPassageiros.filter(
                                        p =>
                                            p.cidade === c
                                    )
                                );
                        }
                    );

                    return lista;
                }

                function ajustarNaRota(coords) {

                    if (!ehDesktop()) {
                        definirSheet('min');
                    }

                    map.fitBounds(
                        L.latLngBounds(coords),
                        {
                            paddingTopLeft:
                                [
                                    ehDesktop()
                                        ? 400
                                        : 30,
                                    90
                                ],

                            paddingBottomRight:
                                [
                                    30,
                                    (
                                        ehDesktop()
                                            ? 0
                                            : 150
                                    ) + 30
                                ]
                        }
                    );
                }

                function limparRota() {

                    tokenRota++;

                    rotaAtiva = null;

                    if (camadaRota) {

                        map.removeLayer(
                            camadaRota
                        );

                        camadaRota = null;
                    }

                    areaMapa.classList.remove(
                        'com-rota'
                    );

                    document.getElementById(
                        'rota-banner'
                    ).style.display =
                        'none';

                    renderizarListas();
                }

                async function mostrarRota(i) {

                    if (
                        rotaAtiva === i
                    ) {

                        limparRota();

                        return;
                    }

                    const r =
                        rotas[i];

                    if (!r) {
                        return;
                    }

                    const pts =
                        pontosDaRota(r);

                    if (
                        pts.length < 2
                    ) {

                        mostrarAviso(
                            'Não achei pontos para a rota "' +
                            r.descricao +
                            '". Cite as cidades da rota na descrição.',
                            false
                        );

                        setTimeout(
                            esconderAviso,
                            5000
                        );

                        return;
                    }

                    limparRota();

                    rotaAtiva = i;

                    const token =
                        tokenRota;

                    camadaRota =
                        L.layerGroup()
                            .addTo(map);

                    areaMapa.classList.add(
                        'com-rota'
                    );

                    document.getElementById(
                        'rb-titulo'
                    ).textContent =
                        r.descricao;

                    document.getElementById(
                        'rb-sub'
                    ).textContent =
                        pts.length +
                        ' pontos · tempo médio ' +
                        r.tempo_medio +
                        ' min';

                    document.getElementById(
                        'rota-banner'
                    ).style.display =
                        'flex';

                    pts.forEach(
                        function (p, n) {

                            L.marker(
                                [
                                    p.latitude,
                                    p.longitude
                                ],
                                {
                                    icon:
                                        L.divIcon({
                                            className: '',

                                            html:
                                                `
                                                    <div class="parada-pin">
                                                        ${n + 1}
                                                    </div>
                                                `,

                                            iconSize:
                                                [
                                                    26,
                                                    26
                                                ],

                                            iconAnchor:
                                                [
                                                    13,
                                                    13
                                                ]
                                        }),

                                    zIndexOffset:
                                        500,

                                    interactive:
                                        false
                                }
                            ).addTo(
                                camadaRota
                            );
                        }
                    );

                    let linha =
                        pts.map(
                            p => [
                                p.latitude,
                                p.longitude
                            ]
                        );

                    ajustarNaRota(
                        linha
                    );

                    renderizarListas();

                    try {

                        const url =
                            'https://router.project-osrm.org/route/v1/driving/' +
                            pts.map(
                                p =>
                                    p.longitude +
                                    ',' +
                                    p.latitude
                            ).join(';') +
                            '?overview=full&geometries=geojson';

                        const resposta =
                            await fetch(url);

                        const dados =
                            await resposta.json();

                        if (
                            dados.routes &&
                            dados.routes.length
                        ) {

                            linha =
                                dados.routes[0]
                                    .geometry
                                    .coordinates
                                    .map(
                                        c => [
                                            c[1],
                                            c[0]
                                        ]
                                    );
                        }

                    } catch (erro) {

                        console.error(
                            'Erro ao traçar a rota',
                            erro
                        );
                    }

                    if (
                        token !==
                        tokenRota
                    ) {
                        return;
                    }

                    L.polyline(
                        linha,
                        {
                            color: '#ffffff',
                            weight: 10,
                            opacity: .9
                        }
                    ).addTo(
                        camadaRota
                    );

                    L.polyline(
                        linha,
                        {
                            color: '#7a1f1f',
                            weight: 6,
                            opacity: .95
                        }
                    ).addTo(
                        camadaRota
                    );

                    ajustarNaRota(
                        linha
                    );
                }

                /* =========================================================
                   ABAS
                ========================================================= */

                function trocarAba(aba) {

                    abaAtual = aba;

                    document
                        .querySelectorAll(
                            '.abas button'
                        )
                        .forEach(
                            function (b) {

                                b.classList.toggle(
                                    'ativa',
                                    b.dataset.aba === aba
                                );
                            }
                        );

                    [
                        'pontos',
                        'onibus',
                        'rotas'
                    ].forEach(
                        function (a) {

                            document.getElementById(
                                'lista-' + a
                            ).style.display =
                                a === aba
                                    ? 'block'
                                    : 'none';
                        }
                    );

                    document.getElementById(
                        'chips-cidades'
                    ).style.display =
                        aba === 'rotas'
                            ? 'none'
                            : 'flex';
                }

                /* =========================================================
                   PAINEL DESLIZANTE
                ========================================================= */

                function altSheet(e) {

                    const h =
                        areaMapa.clientHeight;

                    return e === 'min'
                        ? 150
                        : e === 'mid'
                            ? Math.round(
                                h * .45
                            )
                            : Math.round(
                                h * .88
                            );
                }

                function aplicarSheet(
                    px,
                    animar
                ) {

                    sheet.style.transition =
                        animar
                            ? 'height .25s ease'
                            : 'none';

                    sheet.style.height =
                        px + 'px';

                    areaMapa.style.setProperty(
                        '--sh',
                        px + 'px'
                    );
                }

                function definirSheet(e) {

                    estadoSheet = e;

                    if (ehDesktop()) {

                        sheet.style.height =
                            '';

                        areaMapa.style.removeProperty(
                            '--sh'
                        );

                        return;
                    }

                    aplicarSheet(
                        altSheet(e),
                        true
                    );
                }

                function ajustarAltura() {

                    const topo =
                        areaMapa.getBoundingClientRect()
                            .top +
                        window.scrollY;

                    areaMapa.style.height =
                        Math.max(
                            420,
                            window.innerHeight -
                            topo
                        ) + 'px';

                    map.invalidateSize();

                    definirSheet(
                        estadoSheet
                    );
                }

                /* =========================================================
                   MAPA
                ========================================================= */

                function verTudo() {

                    if (
                        !marcadoresPontos.length
                    ) {
                        return;
                    }

                    const grupo =
                        L.featureGroup(
                            marcadoresPontos.map(
                                i => i.marker
                            )
                        );

                    map.fitBounds(
                        grupo.getBounds(),
                        {
                            paddingTopLeft:
                                [
                                    ehDesktop()
                                        ? 400
                                        : 30,
                                    30
                                ],

                            paddingBottomRight:
                                [
                                    30,
                                    (
                                        ehDesktop()
                                            ? 0
                                            : sheet.offsetHeight
                                    ) + 30
                                ]
                        }
                    );
                }

                function centralizarUsuario() {

                    if (marcadorUsuario) {

                        map.flyTo(
                            marcadorUsuario.getLatLng(),
                            16
                        );
                    }
                }

                function irPara(marker) {

                    if (!ehDesktop()) {

                        definirSheet(
                            'min'
                        );
                    }

                    map.flyTo(
                        marker.getLatLng(),
                        16,
                        {
                            duration: .8
                        }
                    );

                    marker.openPopup();
                }

                /* =========================================================
                   EVENTOS DO PAINEL
                ========================================================= */

                sheet.addEventListener(
                    'click',
                    function (e) {

                        const cid =
                            e.target.closest(
                                '[data-cidade]'
                            );

                        if (cid) {

                            cidadeAtual =
                                cid.dataset.cidade;

                            renderizarListas();

                            return;
                        }

                        const aba =
                            e.target.closest(
                                '[data-aba]'
                            );

                        if (aba) {

                            trocarAba(
                                aba.dataset.aba
                            );

                            return;
                        }

                        const rt =
                            e.target.closest(
                                '[data-rota]'
                            );

                        if (rt) {

                            mostrarRota(
                                Number(
                                    rt.dataset.rota
                                )
                            );

                            return;
                        }

                        const pt =
                            e.target.closest(
                                '[data-ponto]'
                            );

                        if (pt) {

                            irPara(
                                marcadoresPontos[
                                    pt.dataset.ponto
                                ].marker
                            );

                            return;
                        }

                        const bs =
                            e.target.closest(
                                '[data-onibus]'
                            );

                        if (bs) {

                            const m =
                                marcadoresOnibus.find(
                                    x =>
                                        String(
                                            x.dados.numero
                                        ) ===
                                        bs.dataset.onibus
                                );

                            if (m) {

                                irPara(
                                    m.marker
                                );
                            }
                        }
                    }
                );

                /* =========================================================
                   BUSCA
                ========================================================= */

                const campoBusca =
                    document.getElementById(
                        'busca'
                    );

                campoBusca.addEventListener(
                    'input',
                    function () {

                        termoBusca =
                            campoBusca.value;

                        renderizarListas();
                    }
                );

                campoBusca.addEventListener(
                    'focus',
                    function () {

                        if (!ehDesktop()) {

                            definirSheet(
                                'max'
                            );
                        }
                    }
                );

                /* =========================================================
                   ROLAGEM DOS CHIPS
                   MOUSE + ARRASTAR + TOUCH
                ========================================================= */

                const chips =
                    document.getElementById(
                        'chips-cidades'
                    );

                let chipsArrastando = false;

                let chipsInicioX = 0;

                let chipsScrollInicial = 0;

                let chipsMoveu = false;

                chips.addEventListener(
                    'pointerdown',
                    function (e) {

                        chipsArrastando = true;

                        chipsMoveu = false;

                        chipsInicioX =
                            e.clientX;

                        chipsScrollInicial =
                            chips.scrollLeft;

                        chips.classList.add(
                            'arrastando'
                        );

                        try {
                            chips.setPointerCapture(
                                e.pointerId
                            );
                        } catch (erro) {}
                    }
                );

                chips.addEventListener(
                    'pointermove',
                    function (e) {

                        if (
                            !chipsArrastando
                        ) {
                            return;
                        }

                        const deslocamento =
                            e.clientX -
                            chipsInicioX;

                        if (
                            Math.abs(
                                deslocamento
                            ) > 5
                        ) {
                            chipsMoveu = true;
                        }

                        chips.scrollLeft =
                            chipsScrollInicial -
                            deslocamento;
                    }
                );

                function finalizarArrastoChips() {

                    chipsArrastando = false;

                    chips.classList.remove(
                        'arrastando'
                    );
                }

                chips.addEventListener(
                    'pointerup',
                    finalizarArrastoChips
                );

                chips.addEventListener(
                    'pointercancel',
                    finalizarArrastoChips
                );

                chips.addEventListener(
                    'pointerleave',
                    function () {

                        if (
                            chipsArrastando
                        ) {
                            finalizarArrastoChips();
                        }
                    }
                );

                /*
                 * Roda do mouse:
                 * quando o usuário gira para cima/baixo,
                 * transformamos em rolagem horizontal.
                 */

                chips.addEventListener(
                    'wheel',
                    function (e) {

                        if (
                            Math.abs(e.deltaY) >
                            Math.abs(e.deltaX)
                        ) {

                            chips.scrollLeft +=
                                e.deltaY;

                            e.preventDefault();
                        }
                    },
                    {
                        passive: false
                    }
                );

                /*
                 * Evita selecionar cidade quando
                 * o usuário estava apenas arrastando.
                 */

                chips.addEventListener(
                    'click',
                    function (e) {

                        if (chipsMoveu) {

                            e.preventDefault();

                            e.stopPropagation();

                            chipsMoveu = false;
                        }
                    },
                    true
                );

                /* =========================================================
                   ARRASTAR PAINEL NO CELULAR
                ========================================================= */

                const topoSheet =
                    document.getElementById(
                        'sheet-topo'
                    );

                let arrasto = null;

                topoSheet.addEventListener(
                    'pointerdown',
                    function (e) {

                        if (ehDesktop()) {
                            return;
                        }

                        arrasto = {

                            y: e.clientY,

                            h: sheet.offsetHeight,

                            moveu: false
                        };

                        topoSheet.setPointerCapture(
                            e.pointerId
                        );
                    }
                );

                topoSheet.addEventListener(
                    'pointermove',
                    function (e) {

                        if (!arrasto) {
                            return;
                        }

                        const d =
                            arrasto.y -
                            e.clientY;

                        if (
                            Math.abs(d) > 5
                        ) {
                            arrasto.moveu = true;
                        }

                        if (
                            arrasto.moveu
                        ) {

                            aplicarSheet(

                                Math.min(
                                    altSheet('max'),
                                    Math.max(
                                        110,
                                        arrasto.h + d
                                    )
                                ),

                                false
                            );
                        }
                    }
                );

                function soltarSheet() {

                    if (!arrasto) {
                        return;
                    }

                    const a =
                        arrasto;

                    arrasto = null;

                    if (!a.moveu) {

                        definirSheet(
                            estadoSheet === 'mid'
                                ? 'max'
                                : 'mid'
                        );

                        return;
                    }

                    const h =
                        sheet.offsetHeight;

                    const melhor =
                        [
                            'min',
                            'mid',
                            'max'
                        ].reduce(
                            function (m, e) {

                                return Math.abs(
                                    altSheet(e) -
                                    h
                                ) < Math.abs(
                                    altSheet(m) -
                                    h
                                )
                                    ? e
                                    : m;
                            }
                        );

                    definirSheet(
                        melhor
                    );
                }

                topoSheet.addEventListener(
                    'pointerup',
                    soltarSheet
                );

                topoSheet.addEventListener(
                    'pointercancel',
                    soltarSheet
                );

                /* =========================================================
                   INÍCIO
                ========================================================= */

                renderizarListas();

                atualizarMotorista();

                obterLocalizacao();

                onibus.forEach(
                    function (bus, i) {

                        setTimeout(
                            function () {
                                calcularRota(bus);
                            },
                            i * 300
                        );
                    }
                );

                let ultimoTick =
                    performance.now();

                setInterval(
                    function () {

                        const agora =
                            performance.now();

                        const dt =
                            Math.min(
                                (
                                    agora -
                                    ultimoTick
                                ) / 1000,
                                2
                            );

                        ultimoTick =
                            agora;

                        onibus.forEach(
                            function (bus) {

                                moverOnibus(
                                    bus,
                                    dt
                                );
                            }
                        );

                    },
                    500
                );

                /*
                 * Atualiza alertas simulados
                 * a cada 12 segundos.
                 */

                setInterval(
                    function () {

                        atualizarAlertasSimulados();

                        renderizarListas();

                        atualizarPopups();

                    },
                    12000
                );

                setInterval(
                    atualizarInterface,
                    1000
                );

                ajustarAltura();

                setTimeout(
                    function () {

                        ajustarAltura();

                        if (
                            !centralizouUsuario
                        ) {

                            verTudo();
                        }

                    },
                    700
                );

                window.addEventListener(
                    'resize',
                    ajustarAltura
                );

            </script>

</body>

</html>