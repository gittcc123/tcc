                /* =========================================================
                   ATUALIZA POPUPS
                ========================================================= */

                function atualizarPopups() {

                    marcadoresPontos
                        .concat(marcadoresOnibus)
                        .forEach(
                            function (item) {

                                if (
                                    !item.marker.isPopupOpen()
                                ) {
