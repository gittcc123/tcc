<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

    <body class="bg-light">

        <%- include('../../partials/header') %>

            <div class="d-flex">

                <%- include('../../partials/sidebar') %>

                    <main class="content w-100">

                        <div class="container-fluid px-4 py-4">

                            <!-- CABEÇALHO -->
                            <div class="mb-4">
                                <div class="d-flex align-items-center gap-3">

                                    <div class="page-icon">
                                        <i class="bi bi-pencil-square"></i>
                                    </div>

                                    <div>
                                        <h1 class="page-title mb-1">
                                            Editar Veículo
                                        </h1>

                                        <p class="text-muted mb-0">
                                            Atualize as informações do veículo cadastrado.
                                        </p>
                                    </div>

                                </div>
                            </div>


                            <!-- CARD PRINCIPAL -->
                            <div class="card vehicle-form-card border-0 shadow-sm">

                                <div class="card-body p-4 p-lg-5">

                                    <!-- MENSAGEM -->
                                    <% if (typeof mensagem !=='undefined' && mensagem) { %>

                                        <div class="alert
                                <%= mensagem.tipo === 'success'
                                    ? 'alert-success'
                                    : 'alert-danger' %>
                                d-flex align-items-start gap-3 border-0 shadow-sm mb-4">

                                            <i class="bi
                                    <%= mensagem.tipo === 'success'
                                        ? 'bi-check-circle-fill'
                                        : 'bi-exclamation-circle-fill' %>
                                    fs-4"></i>

                                            <div>
                                                <strong>
                                                    <%= mensagem.tituloMensagem %>
                                                </strong>

                                                <div class="mt-1">
                                                    <%= mensagem.valor %>
                                                </div>
                                            </div>

                                        </div>

                                        <% } %>


                                            <!-- IDENTIFICAÇÃO -->
                                            <div class="section-header">

                                                <div class="section-icon">
                                                    <i class="bi bi-bus-front-fill"></i>
                                                </div>

                                                <div>
                                                    <h5 class="mb-1 fw-bold">
                                                        Dados do veículo
                                                    </h5>

                                                    <p class="text-muted mb-0 small">
                                                        Confira e altere os dados necessários.
                                                    </p>
                                                </div>

                                            </div>


                                            <form action="/veiculo/editar/<%= veiculoParaEditar.id %>" method="POST">

                                                <div class="row g-4 mt-1">

                                                    <!-- NÚMERO -->
                                                    <div class="col-md-6">

                                                        <label for="numero_veiculo" class="form-label fw-semibold">
                                                            Número do Veículo
                                                        </label>

                                                        <div class="input-group">

                                                            <span class="input-group-text">
                                                                <i class="bi bi-hash"></i>
                                                            </span>

                                                            <input type="number" id="numero_veiculo"
                                                                name="numero_veiculo" class="form-control"
                                                                value="<%= veiculoParaEditar.numero_veiculo %>" min="1"
                                                                required>

                                                        </div>

                                                        <div class="form-text">
                                                            Identificação utilizada para localizar o veículo.
                                                        </div>

                                                    </div>


                                                    <!-- PLACA -->
                                                    <div class="col-md-6">

                                                        <label for="placa" class="form-label fw-semibold">
                                                            Placa
                                                        </label>

                                                        <div class="input-group">

                                                            <span class="input-group-text">
                                                                <i class="bi bi-card-text"></i>
                                                            </span>

                                                            <input type="text" id="placa" name="placa"
                                                                class="form-control"
                                                                value="<%= veiculoParaEditar.placa %>" maxlength="8"
                                                                required>

                                                        </div>

                                                        <div class="form-text">
                                                            Placa utilizada para identificação do veículo.
                                                        </div>

                                                    </div>


                                                    <!-- CAPACIDADE -->
                                                    <div class="col-md-6">

                                                        <label for="capacidade_veiculo" class="form-label fw-semibold">
                                                            Capacidade
                                                        </label>

                                                        <div class="input-group">

                                                            <span class="input-group-text">
                                                                <i class="bi bi-people-fill"></i>
                                                            </span>

                                                            <input type="number" id="capacidade_veiculo"
                                                                name="capacidade_veiculo" class="form-control"
                                                                value="<%= veiculoParaEditar.capacidade_veiculo %>"
                                                                min="1" required>

                                                            <span class="input-group-text">
                                                                passageiros
                                                            </span>

                                                        </div>

                                                        <div class="form-text">
                                                            Quantidade máxima de passageiros.
                                                        </div>

                                                    </div>


                                                    <!-- STATUS -->
                                                    <div class="col-md-6">

                                                        <label for="status_veiculo" class="form-label fw-semibold">
                                                            Status do Veículo
                                                        </label>

                                                        <div class="input-group">

                                                            <span class="input-group-text">
                                                                <i class="bi bi-toggle-on"></i>
                                                            </span>

                                                            <select id="status_veiculo" name="status_veiculo"
                                                                class="form-select" required>

                                                                <option value="true"
                                                                    <%=veiculoParaEditar.status_veiculo===true
                                                                    ? 'selected' : '' %>
                                                                    >
                                                                    Ativo
                                                                </option>

                                                                <option value="false"
                                                                    <%=veiculoParaEditar.status_veiculo===false
                                                                    ? 'selected' : '' %>
                                                                    >
                                                                    Inativo
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <div class="form-text">
                                                            Define se o veículo está disponível para operação.
                                                        </div>

                                                    </div>

                                                </div>


                                                <!-- RESUMO -->
                                                <div class="vehicle-info mt-5">

                                                    <div class="vehicle-info-icon">
                                                        <i class="bi bi-info-circle-fill"></i>
                                                    </div>

                                                    <div>

                                                        <h6 class="fw-bold mb-1">
                                                            Atualização do veículo
                                                        </h6>

                                                        <p class="mb-0 text-muted">
                                                            Verifique os dados antes de salvar as alterações.
                                                            O status define se o veículo poderá ser utilizado
                                                            nas operações do sistema.
                                                        </p>

                                                    </div>

                                                </div>


                                                <!-- BOTÕES -->
                                                <div class="form-actions mt-4">

                                                    <a href="/veiculo/listar" class="btn btn-outline-secondary">
                                                        <i class="bi bi-arrow-left"></i>
                                                        Voltar ao Listar
                                                    </a>

                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="bi bi-check-lg"></i>
                                                        Atualizar Veículo
                                                    </button>

                                                </div>

                                            </form>

                                </div>

                            </div>

                        </div>

                    </main>

            </div>


            <%- include('../../partials/scripts') %>


                <style>
                    .page-icon {
                        width: 52px;
                        height: 52px;
                        background: #8b2e2e;
                        color: white;
                        border-radius: 12px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 22px;
                    }

                    .page-title {
                        font-size: 28px;
                        font-weight: 700;
                        color: #7a1f1f;
                    }

                    .vehicle-form-card {
                        border-radius: 16px;
                        overflow: hidden;
                    }

                    .section-header {
                        display: flex;
                        align-items: center;
                        gap: 14px;
                        padding-bottom: 18px;
                        border-bottom: 1px solid #eee;
                    }

                    .section-icon {
                        width: 42px;
                        height: 42px;
                        border-radius: 10px;
                        background: #f8eaea;
                        color: #8b2e2e;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 18px;
                    }

                    .form-label {
                        color: #343a40;
                        margin-bottom: 8px;
                    }

                    .form-control,
                    .form-select,
                    .input-group-text {
                        min-height: 46px;
                        border-color: #dee2e6;
                    }

                    .form-control:focus,
                    .form-select:focus {
                        border-color: #a52a2a;
                        box-shadow: 0 0 0 0.2rem rgba(139, 46, 46, 0.12);
                    }

                    .input-group-text {
                        background: #f8f9fa;
                        color: #8b2e2e;
                    }

                    .vehicle-info {
                        display: flex;
                        align-items: flex-start;
                        gap: 14px;
                        padding: 18px;
                        border-radius: 12px;
                        background: #f8f9fa;
                        border: 1px solid #e9ecef;
                    }

                    .vehicle-info-icon {
                        width: 38px;
                        height: 38px;
                        flex-shrink: 0;
                        border-radius: 9px;
                        background: #f8eaea;
                        color: #8b2e2e;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    .form-actions {
                        display: flex;
                        justify-content: flex-end;
                        gap: 10px;
                        padding-top: 20px;
                        border-top: 1px solid #eee;
                    }

                    .form-actions .btn {
                        min-height: 44px;
                        padding: 0 20px;
                        font-weight: 600;
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        border-radius: 8px;
                    }

                    .btn-danger {
                        background: #8b2e2e;
                        border-color: #8b2e2e;
                    }

                    .btn-danger:hover {
                        background: #7a1f1f;
                        border-color: #7a1f1f;
                    }

                    @media (max-width: 768px) {

                        .page-title {
                            font-size: 23px;
                        }

                        .form-actions {
                            flex-direction: column-reverse;
                        }

                        .form-actions .btn {
                            width: 100%;
                            justify-content: center;
                        }

                    }
                </style>

    </body>

</html>