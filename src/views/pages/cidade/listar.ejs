<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

    <body class="bg-light">

        <%- include('../../partials/header') %>

            <div class="d-flex">

                <%- include('../../partials/sidebar') %>

                    <div class="content w-100">

                        <div class="container-fluid py-4">

                            <!-- CABEÇALHO -->

                            <div class="card shadow-sm border-0 mb-4">

                                <div class="card-body p-4">

                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                        <div>

                                            <h1 class="text-danger fw-bold mb-1">
                                                Cidades Cadastradas
                                            </h1>

                                            <p class="text-muted mb-0">
                                                Consulte e gerencie as cidades cadastradas no sistema.
                                            </p>

                                        </div>


                                        <!-- BOTÕES -->

                                        <div class="d-flex gap-2">

                                            <!-- CONSULTAR ESTADOS -->
                                            <% if (usuario && usuario.tipo==='ADMIN' ) { %>

                                                <a href="/estado/listar" class="btn btn-secondary px-4 shadow-sm">
                                                    Consultar Estados
                                                </a>


                                                <!-- CADASTRAR CIDADE -->


                                                <a href="/cidade/cadastrar" class="btn btn-danger px-4 shadow-sm">
                                                    Cadastrar Cidade
                                                </a>

                                                <% } %>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- CARD DA TABELA -->

                            <div class="card shadow-sm border-0">

                                <div class="card-body p-0">

                                    <% if (cidades && cidades.length> 0) { %>

                                        <!-- TOTAL -->

                                        <div class="p-3 border-bottom bg-white">

                                            <div class="d-flex justify-content-between align-items-center">

                                                <span class="text-muted">

                                                    Total de cidades:

                                                    <strong class="text-dark">
                                                        <%= cidades.length %>
                                                    </strong>

                                                </span>

                                            </div>

                                        </div>


                                        <!-- TABELA -->

                                        <div class="table-responsive">

                                            <table class="table table-hover align-middle mb-0">

                                                <thead class="table-danger">

                                                    <tr>

                                                        <th class="px-4">
                                                            ID
                                                        </th>

                                                        <th>
                                                            Cidade
                                                        </th>

                                                        <th>
                                                            CEP
                                                        </th>

                                                        <th>
                                                            Estado ID
                                                        </th>

                                                        <th>
                                                            Ações
                                                        </th>

                                                    </tr>

                                                </thead>


                                                <tbody>

                                                    <% cidades.forEach((cidade)=> { %>

                                                        <tr>


                                                            <td class="px-4">

                                                                <span class="badge bg-light text-dark border">
                                                                    <%= cidade.id %>
                                                                </span>

                                                            </td>



                                                            <td>

                                                                <strong>
                                                                    <%= cidade.nome %>
                                                                </strong>

                                                            </td>



                                                            <td>

                                                                <span class="text-muted">
                                                                    <%= cidade.cep %>
                                                                </span>

                                                            </td>



                                                            <td>

                                                                <span class="badge bg-secondary px-3 py-2">
                                                                    <%= cidade.estado_id %>
                                                                </span>

                                                            </td>



                                                            <td>

                                                                <div class="d-flex gap-2">


                                                                    <a href="/cidade/editar/<%= cidade.id %>"
                                                                        class="btn btn-primary btn-sm">
                                                                        Editar
                                                                    </a>


                                                                    <form class="form-excluir m-0"
                                                                        action="/cidade/excluir/<%= cidade.id %>"
                                                                        method="POST">

                                                                        <button type="submit"
                                                                            class="btn btn-danger btn-sm">
                                                                            Excluir
                                                                        </button>

                                                                    </form>

                                                                </div>

                                                            </td>

                                                        </tr>

                                                        <% }) %>

                                                </tbody>

                                            </table>

                                        </div>


                                        <% } else { %>


                                            <!-- NENHUMA CIDADE -->

                                            <div class="text-center p-5">

                                                <h4 class="fw-bold mt-3">
                                                    Nenhuma cidade cadastrada
                                                </h4>

                                                <p class="text-muted">
                                                    Ainda não existem cidades cadastradas no sistema.
                                                </p>


                                                <% if (usuario && usuario.tipo==='ADMIN' ) { %>

                                                    <a href="/cidade/cadastrar" class="btn btn-danger">
                                                        Cadastrar Cidade
                                                    </a>

                                                    <% } %>

                                            </div>

                                            <% } %>


                                </div>

                            </div>

                        </div>

                        <a href="/dashboard" class="btn btn-secondary px-4 shadow-sm">
                            Voltar
                        </a>


                    </div>

            </div>


            <%- include('../../partials/scripts') %>


                <!-- SWEET ALERT -->

                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

                <script>

                    const formsExcluir =
                        document.getElementsByClassName('form-excluir');


                    for (const formExcluir of formsExcluir) {

                        formExcluir.addEventListener(
                            'submit',
                            function (e) {

                                e.preventDefault();

                                Swal.fire({

                                    title: 'Deseja realmente excluir?',

                                    text: 'Esta ação não poderá ser desfeita.',

                                    icon: 'warning',

                                    showCancelButton: true,

                                    confirmButtonColor: '#dc3545',

                                    cancelButtonColor: '#6c757d',

                                    confirmButtonText: 'Sim, excluir',

                                    cancelButtonText: 'Cancelar',

                                    reverseButtons: true

                                }).then((result) => {

                                    if (result.isConfirmed) {

                                        formExcluir.submit();

                                    }

                                });

                            }
                        );

                    }

                </script>


                <!-- ESTILOS -->

                <style>
                    .table tbody tr {
                        transition: all .15s ease;
                    }

                    .table tbody tr:hover {
                        background-color: #fff5f5;
                    }

                    .table thead th {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        color: #842029;
                        white-space: nowrap;
                    }

                    .table tbody td {
                        padding-top: 14px;
                        padding-bottom: 14px;
                    }

                    .btn {
                        border-radius: 7px;
                        font-weight: 600;
                    }

                    @media (max-width: 768px) {

                        .container-fluid {
                            padding-left: 10px;
                            padding-right: 10px;
                        }

                        .card-body {
                            padding: 15px !important;
                        }

                        .table {
                            font-size: 14px;
                        }

                        .table tbody td,
                        .table thead th {
                            padding-left: 10px;
                            padding-right: 10px;
                        }

                    }
                </style>


    </body>

</html>