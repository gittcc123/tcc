<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

<body class="bg-light">

    <%- include('../../partials/header') %>

    <div class="d-flex">

        <%- include('../../partials/sidebar') %>

        <div class="content w-100">

            <div class="container-fluid py-4">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <div class="mb-4">

                            <h1 class="text-danger fw-bold mb-1">
                                 Cadastro de Cidade
                            </h1>

                            <p class="text-muted mb-0">
                                Informe os dados da cidade e selecione o estado.
                            </p>

                        </div>


                        <form
                            action="/cidade/cadastrar"
                            method="POST"
                        >

                            <div class="row g-4">


                                <!-- CIDADE -->

                                <div class="col-md-6">

                                    <label
                                        for="nome"
                                        class="form-label fw-semibold"
                                    >
                                        Nome da Cidade
                                    </label>

                                    <input
                                        type="text"
                                        id="nome"
                                        name="nome"
                                        class="form-control"
                                        placeholder="Ex: São José do Rio Preto"
                                        maxlength="60"
                                        required
                                    >

                                </div>


                                <!-- CEP -->

                                <div class="col-md-3">

                                    <label
                                        for="cep"
                                        class="form-label fw-semibold"
                                    >
                                        CEP
                                    </label>

                                    <input
                                        type="text"
                                        id="cep"
                                        name="cep"
                                        class="form-control"
                                        placeholder="00000-000"
                                        maxlength="10"
                                        required
                                    >

                                </div>


                                <!-- ESTADO -->

                                <div class="col-md-3">

                                    <label
                                        for="estado_id"
                                        class="form-label fw-semibold"
                                    >
                                        Estado
                                    </label>

                                    <select
                                        id="estado_id"
                                        name="estado_id"
                                        class="form-select"
                                        required
                                    >

                                        <option value="">
                                            Selecione
                                        </option>


                                        <% estados.forEach(estado => { %>

                                            <option
                                                value="<%= estado.id %>"
                                            >

                                                <%= estado.nome_estado %>
                                                -
                                                <%= estado.sigla_estado %>

                                            </option>

                                        <% }) %>

                                    </select>

                                </div>


                            </div>


                            <!-- BOTÕES -->

                            <div class="d-flex gap-2 mt-4">

                                <button
                                    type="submit"
                                    class="btn btn-danger"
                                >
                                     Salvar Cidade
                                </button>


                                <a
                                    href="/cidade/listar"
                                    class="btn btn-outline-secondary"
                                >
                                     Voltar
                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <%- include('../../partials/scripts') %>


    <script>

        // Máscara de CEP

        const cep =
            document.getElementById('cep');

        cep.addEventListener('input', function () {

            let valor =
                this.value.replace(/\D/g, '');

            if (valor.length > 5) {

                valor =
                    valor.substring(0, 5)
                    + '-'
                    + valor.substring(5, 8);

            }

            this.value = valor;

        });

    </script>


</body>

</html>
