<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

<head>

    <style>

        body {
            background: #f4f6f9;
            color: #343a40;
        }

        .content {
            min-height: 100vh;
        }

        /* CABEÇALHO */

        .page-header {
            background: #ffffff;
            border-radius: 14px;
            padding: 24px 28px;
            margin-bottom: 24px;
            border: 1px solid #e9ecef;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        }

        .page-title {
            color: #8f2929;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #6c757d;
            margin: 0;
            font-size: 14px;
        }

        /* BOTÃO PRINCIPAL */

        .btn-primary-custom {
            background: #992d2d;
            border: none;
            color: #fff;
            padding: 11px 18px;
            border-radius: 9px;
            font-weight: 600;
            transition: 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .btn-primary-custom:hover {
            background: #7d2222;
            color: #fff;
            transform: translateY(-1px);
        }

        /* INDICADORES */

        .summary-card {
            background: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
            height: 100%;
        }

        .summary-icon {
            width: 46px;
            height: 46px;
            border-radius: 11px;
            background: #f8e9e9;
            color: #992d2d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }

        .summary-label {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 3px;
        }

        .summary-number {
            font-size: 25px;
            font-weight: 700;
            color: #343a40;
        }

        /* CARD */

        .table-card {
            background: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        }

        .table-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #eeeeee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-card-title {
            font-weight: 700;
            margin: 0;
            color: #343a40;
            font-size: 17px;
        }

        .table-card-description {
            color: #6c757d;
            font-size: 13px;
            margin: 4px 0 0;
        }

        /* TABELA */

        .custom-table {
            margin: 0;
        }

        .custom-table thead {
            background: #992d2d;
            color: #ffffff;
        }

        .custom-table thead th {
            padding: 15px 20px;
            border: none;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .custom-table tbody td {
            padding: 17px 20px;
            border-color: #f0f0f0;
            vertical-align: middle;
        }

        .custom-table tbody tr {
            transition: background 0.15s;
        }

        .custom-table tbody tr:hover {
            background: #fff8f8;
        }

        /* ID */

        .id-badge {
            background: #f1f3f5;
            color: #495057;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 10px;
            border-radius: 7px;
        }

        /* ROTA */

        .route-info {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .route-icon {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            background: #f8e9e9;
            color: #992d2d;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .route-name {
            font-weight: 600;
            color: #343a40;
        }

        .route-id {
            color: #8a8f94;
            font-size: 11px;
            margin-top: 2px;
        }

        /* PONTO */

        .point-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .point-marker {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #f1f3f5;
            color: #992d2d;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .point-name {
            font-weight: 500;
            color: #495057;
        }

        /* AÇÕES */

        .action-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: 0.2s;
            font-size: 15px;
        }

        .edit-btn {
            color: #992d2d;
            border: 1px solid #e5bebe;
            background: #fff;
        }

        .edit-btn:hover {
            background: #992d2d;
            color: #fff;
        }

        .delete-btn {
            color: #b02a37;
            border: 1px solid #e5c2c7;
            background: #fff;
            cursor: pointer;
        }

        .delete-btn:hover {
            background: #b02a37;
            color: #fff;
        }

        /* ESTADO VAZIO */

        .empty-state {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 18px;
            border-radius: 18px;
            background: #f8e9e9;
            color: #992d2d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }

        .empty-title {
            font-weight: 700;
            color: #343a40;
            margin-bottom: 7px;
        }

        .empty-text {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 22px;
        }

        /* MODAL DE CONFIRMAÇÃO */

        .delete-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .delete-modal.active {
            display: flex;
        }

        .delete-modal-content {
            background: #ffffff;
            width: 100%;
            max-width: 430px;
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.20);
            animation: modalShow 0.2s ease;
        }

        .delete-modal-icon {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: #f8e9e9;
            color: #b02a37;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 28px;
        }

        .delete-modal-title {
            font-weight: 700;
            color: #343a40;
            margin-bottom: 8px;
        }

        .delete-modal-text {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .delete-modal-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .cancel-delete {
            border: 1px solid #ced4da;
            background: #ffffff;
            color: #495057;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
        }

        .cancel-delete:hover {
            background: #f1f3f5;
        }

        .confirm-delete {
            border: none;
            background: #b02a37;
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
        }

        .confirm-delete:hover {
            background: #8f202c;
        }

        @keyframes modalShow {

            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        /* RESPONSIVO */

        @media (max-width: 768px) {

            .page-header {
                padding: 20px;
            }

            .page-header-content {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 16px;
            }

            .table-card-header {
                padding: 18px;
            }

            .custom-table thead th,
            .custom-table tbody td {
                padding: 13px 14px;
            }

        }

    </style>

</head>


<body>

    <%- include('../../partials/header') %>


    <div class="d-flex">

        <%- include('../../partials/sidebar') %>


        <main class="content w-100">

            <div class="container-fluid px-4 py-4">


                <!-- CABEÇALHO -->

                <div class="page-header">

                    <div class="d-flex justify-content-between align-items-center page-header-content">

                        <div>

                            <div class="d-flex align-items-center gap-2 mb-2">

                                <span style="
                                    width: 8px;
                                    height: 8px;
                                    background: #992d2d;
                                    border-radius: 50%;
                                    display: inline-block;
                                "></span>

                                <span
                                    class="text-uppercase"
                                    style="
                                        color:#992d2d;
                                        font-size:11px;
                                        font-weight:700;
                                        letter-spacing:1px;
                                    "
                                >
                                    Gerenciamento
                                </span>

                            </div>


                            <h2 class="page-title">
                                Pontos das Rotas
                            </h2>


                            <p class="page-subtitle">
                                Gerencie os pontos associados às rotas do transporte público.
                            </p>

                        </div>

                        
                        <a href="/dashboard" class="btn btn-secondary px-4 shadow-sm">
                            Voltar
                        </a>



                        <!-- BOTÃO CADASTRAR -->

                        <a
                            href="/pontoRota/cadastrar"
                            class="btn-primary-custom"
                        >

                            <i class="bi bi-plus-lg me-1"></i>

                            Novo Ponto Rota

                        </a>

                    </div>

                </div>


                <!-- RESUMO -->

                <div class="row g-3 mb-4">


                    <!-- VÍNCULOS -->

                    <div class="col-md-4">

                        <div class="summary-card">

                            <div class="d-flex align-items-center gap-3">

                                <div class="summary-icon">

                                    <i class="bi bi-signpost-2"></i>

                                </div>


                                <div>

                                    <div class="summary-label">
                                        Vínculos cadastrados
                                    </div>

                                    <div class="summary-number">
                                        <%= pontosRotas ? pontosRotas.length : 0 %>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- PONTOS -->

                    <div class="col-md-4">

                        <div class="summary-card">

                            <div class="d-flex align-items-center gap-3">

                                <div class="summary-icon">

                                    <i class="bi bi-geo-alt"></i>

                                </div>


                                <div>

                                    <div class="summary-label">
                                        Pontos associados
                                    </div>


                                    <div class="summary-number">

                                        <%
                                            const pontosUnicos = pontosRotas
                                                ? [...new Set(
                                                    pontosRotas.map(item =>
                                                        item.ponto?.id
                                                    )
                                                )].length
                                                : 0;
                                        %>

                                        <%= pontosUnicos %>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ROTAS -->

                    <div class="col-md-4">

                        <div class="summary-card">

                            <div class="d-flex align-items-center gap-3">

                                <div class="summary-icon">

                                    <i class="bi bi-sign-turn-right"></i>

                                </div>


                                <div>

                                    <div class="summary-label">
                                        Rotas relacionadas
                                    </div>


                                    <div class="summary-number">

                                        <%
                                            const rotasUnicas = pontosRotas
                                                ? [...new Set(
                                                    pontosRotas.map(item =>
                                                        item.rota?.id
                                                    )
                                                )].length
                                                : 0;
                                        %>

                                        <%= rotasUnicas %>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- TABELA -->

                <div class="table-card">


                    <div class="table-card-header">

                        <div>

                            <h5 class="table-card-title">
                                Relação de pontos e rotas
                            </h5>

                            <p class="table-card-description">
                                Visualize e gerencie os vínculos cadastrados no sistema.
                            </p>

                        </div>


                        <% if (pontosRotas && pontosRotas.length > 0) { %>

                            <span
                                class="badge"
                                style="
                                    background:#f8e9e9;
                                    color:#992d2d;
                                    padding:8px 11px;
                                    font-weight:600;
                                "
                            >

                                <%= pontosRotas.length %>

                                registro(s)

                            </span>

                        <% } %>

                    </div>


                    <% if (pontosRotas && pontosRotas.length > 0) { %>


                        <div class="table-responsive">

                            <table class="table custom-table align-middle">


                                <thead>

                                    <tr>

                                        <th style="width:80px;">
                                            ID
                                        </th>

                                        <th>
                                            Rota
                                        </th>

                                        <th>
                                            Ponto associado
                                        </th>

                                        <th
                                            class="text-center"
                                            style="width:150px;"
                                        >
                                            Ações
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% pontosRotas.forEach(pontoRota => { %>

                                        <tr>


                                            <!-- ID -->

                                            <td>

                                                <span class="id-badge">

                                                    #<%= pontoRota.id %>

                                                </span>

                                            </td>


                                            <!-- ROTA -->

                                            <td>

                                                <div class="route-info">


                                                    <div class="route-icon">

                                                        <i class="bi bi-signpost-2"></i>

                                                    </div>


                                                    <div>

                                                        <div class="route-name">

                                                            <%= pontoRota.rota?.descricao
                                                                || 'Rota não informada' %>

                                                        </div>


                                                        <div class="route-id">

                                                            Rota #<%= pontoRota.rota?.id || '-' %>

                                                        </div>

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- PONTO -->

                                            <td>

                                                <div class="point-info">


                                                    <div class="point-marker">

                                                        <i class="bi bi-geo-alt"></i>

                                                    </div>


                                                    <div class="point-name">

                                                        <%= pontoRota.ponto?.descricao
                                                            || 'Ponto não informado' %>

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- AÇÕES -->

                                            <td class="text-center">

                                                <div class="d-flex justify-content-center gap-2">


                                                    <!-- EDITAR -->

                                                    <a
                                                        href="/pontoRota/editar/<%= pontoRota.id %>"
                                                        class="action-btn edit-btn"
                                                        title="Editar"
                                                    >

                                                        <i class="bi bi-pencil"></i>

                                                    </a>


                                                    <!-- EXCLUIR -->

                                                    <form
                                                        action="/pontoRota/excluir/<%= pontoRota.id %>"
                                                        method="POST"
                                                        class="delete-form"
                                                        style="display:inline;"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="action-btn delete-btn"
                                                            title="Excluir"
                                                        >

                                                            <i class="bi bi-trash"></i>

                                                        </button>

                                                    </form>


                                                </div>

                                            </td>


                                        </tr>

                                    <% }) %>


                                </tbody>

                            </table>

                        </div>


                    <% } else { %>


                        <!-- ESTADO VAZIO -->

                        <div class="empty-state">


                            <div class="empty-icon">

                                <i class="bi bi-signpost-2"></i>

                            </div>


                            <h5 class="empty-title">

                                Nenhum ponto associado

                            </h5>


                            <p class="empty-text">

                                Ainda não existem pontos vinculados às rotas.
                                Cadastre o primeiro vínculo para começar a organizar o trajeto.

                            </p>


                            <a
                                href="/pontoRota/cadastrar"
                                class="btn-primary-custom"
                            >

                                <i class="bi bi-plus-lg me-2"></i>

                                Adicionar primeiro ponto

                            </a>


                        </div>


                    <% } %>


                </div>

            </div>

        </main>

    </div>


    <!-- MODAL DE CONFIRMAÇÃO -->

    <div
        id="deleteModal"
        class="delete-modal"
    >

        <div class="delete-modal-content">


            <div class="delete-modal-icon">

                <i class="bi bi-trash"></i>

            </div>


            <h4 class="delete-modal-title">

                Confirmar exclusão

            </h4>


            <p class="delete-modal-text">

                Tem certeza que deseja excluir este ponto da rota?

                <br>

                Essa ação não poderá ser desfeita.

            </p>


            <div class="delete-modal-buttons">

                <button
                    type="button"
                    class="cancel-delete"
                    id="cancelDelete"
                >

                    Cancelar

                </button>


                <button
                    type="button"
                    class="confirm-delete"
                    id="confirmDelete"
                >

                    <i class="bi bi-trash me-1"></i>

                    Excluir

                </button>

            </div>

        </div>

    </div>


    <!-- JAVASCRIPT -->

    <script>

        const deleteModal =
            document.getElementById('deleteModal');

        const cancelDelete =
            document.getElementById('cancelDelete');

        const confirmDelete =
            document.getElementById('confirmDelete');

        let formParaExcluir = null;


        // ABRIR CONFIRMAÇÃO

        document
            .querySelectorAll('.delete-form')
            .forEach(form => {

                form.addEventListener('submit', function(event) {

                    event.preventDefault();

                    formParaExcluir = form;

                    deleteModal.classList.add('active');

                });

            });


        // CANCELAR

        cancelDelete.addEventListener('click', function() {

            formParaExcluir = null;

            deleteModal.classList.remove('active');

        });


        // CONFIRMAR

        confirmDelete.addEventListener('click', function() {

            if (formParaExcluir) {

                formParaExcluir.submit();

            }

        });


        // FECHAR CLICANDO FORA

        deleteModal.addEventListener('click', function(event) {

            if (event.target === deleteModal) {

                formParaExcluir = null;

                deleteModal.classList.remove('active');

            }

        });


        // FECHAR COM ESC

        document.addEventListener('keydown', function(event) {

            if (event.key === 'Escape') {

                formParaExcluir = null;

                deleteModal.classList.remove('active');

            }

        });

    </script>


</body>

</html>