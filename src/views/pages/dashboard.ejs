        <!-- =====================================================
             ALERTAS
        ====================================================== -->

        
<section class="dashboard-section">

    <div class="section-header">

        <div class="section-title-wrapper">

            <div class="section-title-icon">

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                    <path d="M10 21h4"></path>
                </svg>

            </div>

            <div>

                <h2 class="section-title">
                    Alertas emitidos
                </h2>

                <p class="section-description">
                    Informações comunicadas por motoristas e administradores.
                </p>

            </div>

        </div>


        <% if (
            usuario &&
            (usuario.tipo === 'MOTORISTA' || usuario.tipo === 'ADMIN')
        ) { %>

            <a
                href="/alerta/cadastrar"
                class="btn-role"
            >
                Novo alerta
            </a>

        <% } %>

    </div>


    <div class="alerts-panel">

        <% if (alertas && alertas.length > 0) { %>

            <% alertas.forEach(function(alerta) { %>

                <div class="alert-item">

                    <div class="alert-icon">
                        !
                    </div>


                    <div class="alert-content">

                        <div class="alert-origin">
                            <%= alerta.tipo || 'Aviso' %>
                        </div>


                        <div class="alert-message">

                            <% if (
                                alerta.localizacao &&
                                alerta.localizacao.veiculo &&
                                alerta.localizacao.veiculo.numero_veiculo
                            ) { %>

                                <strong>
                                    Motorista do veículo
                                    <%= alerta.localizacao.veiculo.numero_veiculo %>
                                    informa que:
                                </strong>

                            <% } else { %>

                                <strong>
                                    O sistema informa que:
                                </strong>

                            <% } %>

                            <%= alerta.mensagem || 'Nenhuma mensagem informada.' %>

                        </div>


                        <div class="alert-date">

                            Emitido em:

                            <%= alerta.data_criacao
                                ? new Date(alerta.data_criacao).toLocaleString('pt-BR')
                                : 'Data não informada'
                            %>

                        </div>


                        <div class="alert-footer">

                            <% if (alerta.status === 'Ativo') { %>

                                <span class="alert-status">
                                    ATIVO
                                </span>

                            <% } else { %>

                                <span class="alert-status inactive">
                                    <%= alerta.status || 'SEM STATUS' %>
                                </span>

                            <% } %>


                            <% if (
                                usuario &&
                                (
                                    usuario.tipo === 'ADMIN' ||
                                    usuario.tipo === 'MOTORISTA'
                                )
                            ) { %>

                                <a
                                    href="/alerta/editar/<%= alerta.id %>"
                                    class="btn-alert-edit"
                                >
                                    Editar
                                </a>

                            <% } %>

                        </div>

                    </div>

                </div>

            <% }); %>

        <% } else { %>

            <div class="empty-alert">

                <div class="empty-alert-icon">
                    !
                </div>

                <strong>
                    Nenhum alerta emitido
                </strong>

                <span>
                    Não existem alertas registrados no momento.
                </span>

            </div>

        <% } %>

    </div>

</section>




    </div>

</div>


