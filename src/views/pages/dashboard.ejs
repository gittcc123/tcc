<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head') %>

<body class="bg-light">

<%- include('../partials/header') %>

<div class="d-flex">

<%- include('../partials/sidebar') %>

<main class="content w-100">

<style>
@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap');

:root {
    --red: #D62828;
    --red-dark: #991F1F;
    --red-hover: #B92020;
    --red-light: #FCEAEA;

    --black: #202020;
    --text: #4B4B4B;
    --muted: #777777;

    --white: #FFFFFF;
    --background: #F5F6F8;
    --surface: #FFFFFF;
    --border: #E4E6E9;

    --green: #258B45;
    --green-light: #EAF7EE;

    --yellow: #D99A00;
    --yellow-light: #FFF6D9;

    --shadow: 0 3px 14px rgba(0, 0, 0, .045);
    --shadow-hover: 0 10px 25px rgba(0, 0, 0, .09);
}

* {
    box-sizing: border-box;
}

.dashboard-page {
    min-height: 100vh;
    background: var(--background);
    font-family: 'Archivo', system-ui, sans-serif;
    color: var(--text);
}


/* =====================================================
   BANNER
===================================================== */

.dashboard-banner {
    position: relative;
    min-height: 225px;
    padding: 40px 42px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    overflow: hidden;

    background: var(--red-dark);
    color: #fff;
}

.dashboard-banner::before {
    content: "";

    position: absolute;

    width: 390px;
    height: 390px;

    right: -125px;
    top: -170px;

    border: 75px solid rgba(255,255,255,.035);
    border-radius: 50%;
}

.dashboard-banner::after {
    content: "";

    position: absolute;

    width: 260px;
    height: 260px;

    right: 190px;
    bottom: -190px;

    border: 45px solid rgba(255,255,255,.025);
    border-radius: 50%;
}

.banner-content {
    position: relative;
    z-index: 2;

    max-width: 800px;
}

.banner-label {
    margin-bottom: 9px;

    color: #E7CFCF;

    font-size: 11px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: .1em;
}

.dashboard-banner h1 {
    margin: 0 0 10px;

    color: #fff;

    font-size: clamp(30px, 3.4vw, 43px);
    line-height: 1;

    font-weight: 900;
    letter-spacing: -.025em;
}

.dashboard-banner p {
    max-width: 720px;

    margin: 0;

    color: #E6DCDC;

    font-size: 14px;
    line-height: 1.65;
    font-weight: 500;
}

.system-status {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    gap: 9px;

    padding: 10px 14px;

    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 7px;

    color: #fff;

    font-size: 11px;
    font-weight: 700;

    white-space: nowrap;
}

.status-dot {
    width: 8px;
    height: 8px;

    flex-shrink: 0;

    border-radius: 50%;

    background: #64D88A;
    box-shadow: 0 0 0 4px rgba(100,216,138,.12);
}


/* =====================================================
   CONTEÚDO
===================================================== */

.dashboard-content {
    width: 100%;
    max-width: 1600px;

    padding: 32px 38px 60px;
}


/* =====================================================
   SEÇÕES
===================================================== */

.dashboard-section {
    margin-bottom: 38px;
}

.section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 17px;
}

.section-title-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
}

.section-title-icon {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: var(--red-light);
    color: var(--red);
}

.section-title-icon svg {
    width: 20px;
    height: 20px;
}

.section-title {
    margin: 0;

    color: var(--black);

    font-size: 20px;
    font-weight: 800;

    letter-spacing: -.02em;
}

.section-description {
    margin: 5px 0 0;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.5;
}


/* =====================================================
   ESTATÍSTICAS
===================================================== */

.stats-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 10px;
}

.stat-card {
    position: relative;

    min-height: 150px;

    padding: 23px 24px 22px 27px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 12px;

    box-shadow: var(--shadow);

    overflow: hidden;

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
}

.stat-card::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 4px;

    background: var(--red);
}

.stat-card.points::before {
    background: var(--green);
}

.stat-card.routes::before {
    background: var(--yellow);
}

.stat-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 15px;
}

.stat-label {
    color: var(--muted);

    font-size: 11px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: .07em;
}

.stat-number {
    margin-top: 9px;

    color: var(--black);

    font-size: 35px;
    line-height: 1;

    font-weight: 900;
}

.stat-description {
    margin-top: 10px;

    color: var(--text);

    font-size: 12px;
}

.stat-icon {
    width: 43px;
    height: 43px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--red-light);
    color: var(--red);
}

.stat-icon svg {
    width: 22px;
    height: 22px;
}

.points .stat-icon {
    background: var(--green-light);
    color: var(--green);
}

.routes .stat-icon {
    background: var(--yellow-light);
    color: var(--yellow);
}


/* =====================================================
   ACESSOS
===================================================== */

.access-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 14px;
}

.access-card {
    min-height: 118px;

    display: flex;
    align-items: center;

    gap: 16px;

    padding: 18px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: 11px;

    box-shadow: var(--shadow);

    text-decoration: none !important;

    transition:
        transform .18s ease,
        border-color .18s ease,
        box-shadow .18s ease;
}

.access-card:hover {
    transform: translateY(-3px);

    border-color: #D9AAAA;

    box-shadow: var(--shadow-hover);
}

.access-icon {
    width: 48px;
    height: 48px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--red-light);
    color: var(--red);
}

.access-icon svg {
    width: 22px;
    height: 22px;
}

.access-card:hover .access-icon {
    background: var(--red);
    color: #fff;
}

.access-content {
    min-width: 0;
}

.access-content h4 {
    margin: 0 0 6px;

    color: var(--black);

    font-size: 14px;
    font-weight: 800;
}

.access-content p {
    margin: 0;

    color: var(--muted);

    font-size: 11.5px;
    line-height: 1.5;
}


/* =====================================================
   BOTÃO
===================================================== */

.btn-role {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 38px;

    padding: 9px 16px;

    border: 1px solid var(--red);
    border-radius: 7px;

    background: var(--red);
    color: #fff !important;

    text-decoration: none !important;

    font-size: 12px;
    font-weight: 700;

    transition:
        background .18s ease,
        border-color .18s ease,
        transform .18s ease,
        box-shadow .18s ease;
}

.btn-role:hover {
    background: var(--red-dark);
    border-color: var(--red-dark);

    color: #fff !important;

    transform: translateY(-1px);

    box-shadow: 0 4px 10px rgba(214,40,40,.18);
}


/* =====================================================
   ADMINISTRAÇÃO
===================================================== */

.admin-panel {
    padding: 24px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: 13px;

    box-shadow: var(--shadow);
}

.admin-header {
    display: flex;
    align-items: center;

    gap: 13px;

    margin-bottom: 21px;
    padding-bottom: 18px;

    border-bottom: 1px solid var(--border);
}

.admin-header-icon {
    width: 42px;
    height: 42px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: var(--red-light);
    color: var(--red);
}

.admin-header-icon svg {
    width: 21px;
    height: 21px;
}

.admin-header h3 {
    margin: 0;

    color: var(--black);

    font-size: 16px;
    font-weight: 800;
}

.admin-header p {
    margin: 4px 0 0;

    color: var(--muted);

    font-size: 12px;
}

.admin-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 10px;
}

.admin-link {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 52px;

    padding: 13px 15px;

    background: #FAFAFA;

    border: 1px solid var(--border);
    border-radius: 8px;

    color: var(--black) !important;

    text-decoration: none !important;

    text-align: center;

    font-size: 13px;
    font-weight: 700;

    transition:
        background .18s ease,
        color .18s ease,
        border-color .18s ease,
        transform .18s ease;
}

.admin-link:hover {
    background: var(--red);
    border-color: var(--red);

    color: #fff !important;

    transform: translateY(-2px);
}


/* =====================================================
   ALERTAS
===================================================== */

.alerts-panel {
    padding: 14px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: 13px;

    box-shadow: var(--shadow);
}

.alert-item {
    display: flex;
    align-items: flex-start;

    gap: 14px;

    padding: 16px;
    margin-bottom: 9px;

    background: #FAFAFA;

    border: 1px solid var(--border);
    border-left: 4px solid var(--red);

    border-radius: 8px;

    transition:
        background .18s ease,
        transform .18s ease,
        box-shadow .18s ease;
}

.alert-item:last-child {
    margin-bottom: 0;
}

.alert-item:hover {
    background: #fff;

    transform: translateX(2px);

    box-shadow: 0 5px 15px rgba(0,0,0,.05);
}

.alert-icon {
    width: 34px;
    height: 34px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--red-light);
    color: var(--red);

    border-radius: 7px;

    font-size: 13px;
    font-weight: 900;
}

.alert-content {
    flex: 1;
    min-width: 0;
}

.alert-origin {
    margin-bottom: 5px;

    color: var(--red);

    font-size: 11px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: .04em;
}

.alert-message {
    color: var(--text);

    font-size: 13.5px;
    line-height: 1.5;
}

.alert-message strong {
    color: var(--black);
}

.alert-date {
    margin-top: 8px;

    color: var(--muted);

    font-size: 11px;
}


/* =====================================================
   STATUS + AÇÕES
===================================================== */

.alert-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-top: 8px;
}

.alert-status {
    display: inline-block;

    margin-top: 0;

    padding: 4px 9px;

    border-radius: 20px;

    background: var(--green-light);
    color: var(--green);

    font-size: 10px;
    font-weight: 800;
}

.alert-status.inactive {
    background: #F1F1F1;
    color: #777;
}


/* =====================================================
   BOTÃO EDITAR
===================================================== */

.btn-alert-edit {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 32px;

    padding: 6px 14px;

    background: #FFFFFF;

    border: 1px solid var(--red);
    border-radius: 6px;

    color: var(--red) !important;

    text-decoration: none !important;

    font-size: 11px;
    font-weight: 800;

    transition:
        background .18s ease,
        color .18s ease,
        border-color .18s ease,
        transform .18s ease,
        box-shadow .18s ease;
}

.btn-alert-edit:hover {
    background: var(--red);
    border-color: var(--red);

    color: #FFFFFF !important;

    transform: translateY(-1px);

    box-shadow: 0 4px 10px rgba(214, 40, 40, .16);
}


/* =====================================================
   ALERTA VAZIO
===================================================== */

.empty-alert {
    padding: 35px 20px;

    text-align: center;

    color: var(--muted);

    font-size: 13px;
}

.empty-alert-icon {
    width: 50px;
    height: 50px;

    margin: 0 auto 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: var(--red-light);
    color: var(--red);

    font-size: 20px;
    font-weight: 900;
}

.empty-alert strong {
    display: block;

    margin-bottom: 5px;

    color: var(--black);
}


/* =====================================================
   RESPONSIVO
===================================================== */

@media (max-width: 480px) {

    .alert-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .btn-alert-edit {
        width: 100%;
    }

}



@media (max-width: 1100px) {

    .access-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .admin-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 900px) {

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-content {
        padding-left: 25px;
        padding-right: 25px;
    }

    .system-status {
        display: none;
    }

}

@media (max-width: 768px) {

    .dashboard-banner {
        min-height: auto;
        padding: 32px 22px 35px;
    }

    .dashboard-content {
        padding: 25px 18px 40px;
    }

    .section-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .access-grid,
    .admin-grid {
        grid-template-columns: 1fr;
    }

    .admin-panel {
        padding: 18px;
    }

}

@media (max-width: 480px) {

    .dashboard-banner h1 {
        font-size: 28px;
    }

    .dashboard-banner p {
        font-size: 13px;
    }

    .stat-card {
        padding: 21px;
    }

    .stat-number {
        font-size: 31px;
    }

    .access-card {
        min-height: 105px;
    }

}
</style>


<div class="dashboard-page">


    <!-- =====================================================
         BANNER
    ====================================================== -->

    <section class="dashboard-banner">

        <div class="banner-content">

            <div class="banner-label">
                Sistema de Transporte Público
            </div>

            <h1>
                Bus Status
            </h1>

            <p>
                Bem-vindo ao Monitoramento de Transporte Público.
                Acompanhe em tempo real a localização dos veículos,
                horários de chegada, rotas e informações importantes
                do transporte público da sua cidade.
            </p>

        </div>

        <div class="system-status">

            <span class="status-dot"></span>

            Sistema em tempo real

        </div>

    </section>


    <div class="dashboard-content">


        <!-- =====================================================
             VISÃO GERAL
        ====================================================== -->

        <section class="dashboard-section">

            <div class="section-header">

                <div class="section-title-wrapper">

                    <div class="section-title-icon">

                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                        </svg>

                    </div>

                    <div>

                        <h2 class="section-title">
                            Visão geral
                        </h2>

                        <p class="section-description">
                            Informações atuais do sistema de transporte.
                        </p>

                    </div>

                </div>

            </div>


            <div class="stats-grid">


                <div class="stat-card">

                    <div class="stat-top">

                        <div>

                            <div class="stat-label">
                                Ônibus em operação
                            </div>

                            <div class="stat-number">
                                <%= typeof totalVeiculos !== 'undefined'
                                    ? totalVeiculos
                                    : 0
                                %>
                            </div>

                            <div class="stat-description">
                                Veículos cadastrados no sistema
                            </div>

                        </div>

                        <div class="stat-icon">

                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 17V7a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v10"></path>
                                <path d="M5 12h14"></path>
                                <path d="M7 17v2"></path>
                                <path d="M17 17v2"></path>
                                <circle cx="8" cy="15" r="1"></circle>
                                <circle cx="16" cy="15" r="1"></circle>
                            </svg>

                        </div>

                    </div>

                </div>


                <div class="stat-card points">

                    <div class="stat-top">

                        <div>

                            <div class="stat-label">
                                Pontos monitorados
                            </div>

                            <div class="stat-number">
                                <%= typeof totalPontos !== 'undefined'
                                    ? totalPontos
                                    : 0
                                %>
                            </div>

                            <div class="stat-description">
                                Pontos de parada cadastrados
                            </div>

                        </div>

                        <div class="stat-icon">

                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                                <circle cx="12" cy="10" r="2.5"></circle>
                            </svg>

                        </div>

                    </div>

                </div>


                <div class="stat-card routes">

                    <div class="stat-top">

                        <div>

                            <div class="stat-label">
                                Rotas ativas
                            </div>

                            <div class="stat-number">
                                <%= typeof totalRotas !== 'undefined'
                                    ? totalRotas
                                    : 0
                                %>
                            </div>

                            <div class="stat-description">
                                Rotas disponíveis no sistema
                            </div>

                        </div>

                        <div class="stat-icon">

                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 19c3-6 5-8 9-8h5"></path>
                                <path d="M15 7h4v4"></path>
                                <circle cx="5" cy="19" r="2"></circle>
                                <circle cx="19" cy="7" r="2"></circle>
                            </svg>

                        </div>

                    </div>

                </div>


            </div>

        </section>


        <!-- =====================================================
             ÁREA DE ACESSO
        ====================================================== -->

        <section class="dashboard-section">

            <div class="section-header">

                <div class="section-title-wrapper">

                    <div class="section-title-icon">

                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                            <path d="M8 9h8"></path>
                            <path d="M8 13h5"></path>
                            <path d="M8 17h3"></path>
                        </svg>

                    </div>

                    <div>

                        <h2 class="section-title">
                            Acesso ao sistema
                        </h2>

                        <p class="section-description">
                            Acesse as funcionalidades disponíveis para seu perfil.
                        </p>

                    </div>

                </div>

            </div>


            <div class="access-grid">


                <!-- =================================================
                     USUARIO
                ================================================== -->

                <% if (usuario && usuario.tipo === 'USUARIO') { %>

                    <a
                        href="/localizacaoVeiculo/listar"
                        class="access-card"
                    >

                        <div class="access-icon">

                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 17V7a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v10"></path>
                                <path d="M5 12h14"></path>
                                <circle cx="8" cy="15" r="1"></circle>
                                <circle cx="16" cy="15" r="1"></circle>
                            </svg>

                        </div>

                        <div class="access-content">

                            <h4>
                                Monitoramento em tempo real
                            </h4>

                            <p>
                                Visualize a localização dos veículos
                                e acompanhe o transporte público.
                            </p>

                        </div>

                    </a>


                    <a
                        href="/rota/listar"
                        class="access-card"
                    >

                        <div class="access-icon">

                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="8"></circle>
