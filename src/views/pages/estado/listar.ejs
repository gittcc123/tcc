<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

<head>

    <style>


        .content {
            min-height: 100vh;
        }

        .page-header {

            background: linear-gradient(
                135deg,
                #dc3545,
                #b02a37
            );

            color: #fff;

            border-radius: 14px;

            padding: 25px 30px;

            margin-bottom: 25px;

            box-shadow:
                0 5px 18px rgba(220, 53, 69, .18);

        }


        .page-header h1 {

            font-size: 28px;

            font-weight: 700;

            margin: 0 0 5px 0;

        }


        .page-header p {

            margin: 0;

            opacity: .9;

        }


        .btn-cadastrar {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            background: #fff;

            color: #dc3545;

            border: none;

            border-radius: 9px;

            padding: 11px 18px;

            font-weight: 700;

            text-decoration: none;

            box-shadow:
                0 4px 10px rgba(0, 0, 0, .15);

            transition: all .2s ease;

        }


        .btn-cadastrar:hover {

            background: #f8f9fa;

            color: #b02a37;

            transform: translateY(-2px);

            box-shadow:
                0 6px 15px rgba(0, 0, 0, .20);

        }


        .btn-cadastrar .icone {

            font-size: 19px;

        }


        .table-card {

            border: none;

            border-radius: 14px;

            overflow: hidden;

            box-shadow:
                0 3px 16px rgba(0, 0, 0, .08);

        }



        .table {

            margin-bottom: 0;

        }


        .table thead th {

            background: #f8d7da;

            color: #842029;

            border-bottom: 1px solid #f1b0b7;

            padding: 15px;

            font-weight: 700;

            white-space: nowrap;

        }


        .table tbody td {

            padding: 15px;

            vertical-align: middle;

        }


        .table tbody tr {

            transition: background .15s ease;

        }


        .table tbody tr:hover {

            background-color: #fff5f5;

        }



        .id-badge {

            color: #6c757d;

            font-weight: 700;

        }



        .sigla-badge {

            background: #6c757d;

            color: #fff;

            font-size: 12px;

            padding: 7px 10px;

            border-radius: 7px;

            font-weight: 700;

        }


        .nome-estado {

            font-weight: 600;

            color: #343a40;

        }



        .acoes {

            display: flex;

            align-items: center;

            gap: 8px;

        }


        .btn-acao {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 5px;

            border-radius: 7px;

            font-weight: 600;

            padding: 6px 12px;

            transition: all .2s ease;

        }


        .btn-acao:hover {

            transform: translateY(-1px);

        }



        .empty-state {

            padding: 60px 20px;

            text-align: center;

        }


        


        .empty-state h4 {

            font-weight: 700;

            color: #343a40;

        }


        .empty-state p {

            color: #6c757d;

            margin-bottom: 20px;

        }



        @media (max-width: 768px) {

            .page-header {

                padding: 20px;

            }


            .page-header h1 {

                font-size: 23px;

            }


            .page-header .d-flex {

                align-items: flex-start !important;

                flex-direction: column;

            }


            .btn-cadastrar {

                width: 100%;

                justify-content: center;

            }


            .acoes {

                flex-direction: column;

                align-items: stretch;

            }


            .btn-acao {

                width: 100%;

            }

        }

    </style>

</head>


<body class="bg-light">


    <%- include('../../partials/header') %>


    <div class="d-flex">


        <%- include('../../partials/sidebar') %>



        <div class="content w-100">


            <div class="container-fluid py-4">


                <div class="page-header">


                    <div class="d-flex justify-content-between align-items-center gap-3">


                        <div>

                            <h1>

                                 Estados Cadastrados

                            </h1>

                            <p>

                                Consulte e gerencie os estados cadastrados no sistema.

                            </p>

                        </div>



                        <a
                            href="/estado/cadastrar"
                            class="btn-cadastrar">

                            <span class="icone">
                                
                            </span>

                            Cadastrar Estado

                        </a>

                        <a href="/dashboard" class="btn btn-secondary px-4 shadow-sm">
                            Voltar
                        </a>


                    </div>


                </div>


                <div class="card table-card">


                    <% if (estados && estados.length > 0) { %>



                        <div class="table-responsive">

                            <table class="table table-hover align-middle">


                                <thead>

                                    <tr>

                                        <th style="width: 100px;">
                                            ID
                                        </th>

                                        <th style="width: 150px;">
                                            Sigla
                                        </th>

                                        <th>
                                            Estado
                                        </th>

                                        <th style="width: 220px;">
                                            Ações
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% estados.forEach(estado => { %>


                                        <tr>


                                            <!-- ID -->

                                            <td>

                                                <span class="id-badge">

                                                    <%= estado.id %>

                                                </span>

                                            </td>


                                            <!-- SIGLA -->

                                            <td>

                                                <span class="sigla-badge">

                                                    <%= estado.sigla_estado %>

                                                </span>

                                            </td>


                                            <!-- ESTADO -->

                                            <td>

                                                <span class="nome-estado">

                                                    <%= estado.nome %>

                                                </span>

                                            </td>


                                            <!-- AÇÕES -->

                                            <td>

                                                <div class="acoes">


                                                    <!-- EDITAR -->

                                                    <a
                                                        href="/estado/editar/<%= estado.id %>"
                                                        class="btn btn-sm btn-primary btn-acao">

                                                         Editar

                                                    </a>


                                                    <!-- EXCLUIR -->

                                                    <form
                                                        class="form-excluir m-0"
                                                        action="/estado/excluir/<%= estado.id %>"
                                                        method="POST">


                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm btn-danger btn-acao">

                                                             Excluir

                                                        </button>


                                                    </form>


                                                </div>

                                            </td>


                                        </tr>


                                    <% }) %>


                                </tbody>


                            </table>

                        </div>


                    <% } else { %>


                        <!-- =========================
                             NENHUM ESTADO
                        ========================== -->

                        <div class="empty-state">


                            

                            <h4>

                                Nenhum estado cadastrado

                            </h4>


                            <p>

                                Ainda não existem estados cadastrados no sistema.

                            </p>


                            <a
                                href="/estado/cadastrar"
                                class="btn btn-danger">

                                Cadastrar Estado

                            </a>


                        </div>


                    <% } %>


                </div>


            </div>


        </div>


    </div>


    <%- include('../../partials/scripts') %>


    <!-- SWEET ALERT -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script>


        const formsExcluir =
            document.getElementsByClassName('form-excluir');


        for (const formExcluir of formsExcluir) {


            formExcluir.addEventListener(
                'submit',
                function (e) {


                    e.preventDefault();


                    Swal.fire({

                        title: 'Deseja realmente excluir?',

                        text:
                            'Esta ação não poderá ser desfeita.',

                        icon: 'warning',

                        showCancelButton: true,

                        confirmButtonColor: '#dc3545',

                        cancelButtonColor: '#6c757d',

                        confirmButtonText:
                            'Sim, excluir',

                        cancelButtonText:
                            'Cancelar',

                        reverseButtons: true

                    }).then((result) => {


                        if (result.isConfirmed) {

                            formExcluir.submit();

                        }


                    });


                }
            );

        }


    </script>


    <% if (mensagem) { %>


        <script>

            Swal.fire({

                icon:
                    '<%= mensagem.tipo %>',

                title:
                    '<%= mensagem.titulo || "Aviso" %>',

                text:
                    '<%= mensagem.valor %>',

                confirmButtonColor:
                    '#dc3545'

            });

        </script>


    <% } %>


</body>

</html>
