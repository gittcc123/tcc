<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../../partials/head') %>

<body class="bg-light">

    <%- include('../../partials/header') %>

    <div class="d-flex">

        <%- include('../../partials/sidebar') %>

        <main class="content w-100">

            <div class="container-fluid px-4 py-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h1 class="fw-bold mb-1">
                            Pontos Monitorados
                        </h1>

                        <p class="text-muted mb-0">
                            Visualize e gerencie os pontos cadastrados no sistema.
                        </p>

                    </div>

                    
                        <a href="/dashboard" class="btn btn-secondary px-4 shadow-sm">
                            Voltar
                        </a>


                    <% if (usuario && usuario.tipo === 'ADMIN') { %>

                        <a
                            href="/ponto/cadastrar"
                            class="btn btn-danger px-4"
                        >
                            <i class="bi bi-plus-lg me-1"></i>
                            Cadastrar Ponto
                        </a>



                    <% } %>

                </div>


                <div class="row g-4">

                    <% if (pontos && pontos.length > 0) { %>

                        <% pontos.forEach((ponto) => { %>

                            <div class="col-12 col-md-6 col-xl-4">

                                <div class="card ponto-card h-100 border-0 shadow-sm">

                                    <div class="card-body p-4">

                                        <div class="d-flex align-items-center mb-4">

                                            <div class="icone-ponto me-3">
                                                <i class="bi bi-geo-alt-fill"></i>
                                            </div>

                                            <div>

                                                <h5 class="fw-bold mb-0">
                                                    <%= ponto.localizacao %>
                                                </h5>

                                                <small class="text-muted">
                                                    Ponto #<%= ponto.id %>
                                                </small>

                                            </div>

                                        </div>


                                        <div class="mb-3">

                                            <span class="titulo-info">
                                                Descrição
                                            </span>

                                            <p class="mb-0 text-secondary">
                                                <%= ponto.descricao %>
                                            </p>

                                        </div>


                                        <div class="info-box mb-3">

                                            <div class="d-flex align-items-center">

                                                <i class="bi bi-building me-2"></i>

                                                <div>

                                                    <small class="text-muted d-block">
                                                        Cidade
                                                    </small>

                                                    <strong>
                                                        <%= ponto.nomeCidade || 'Não informado' %>
                                                    </strong>

                                                </div>

                                            </div>

                                        </div>


                                       


                                        <% if (usuario && usuario.tipo === 'ADMIN') { %>

                                            <div class="d-flex gap-2">

                                                <a
                                                    href="/ponto/editar/<%= ponto.id %>"
                                                    class="btn btn-outline-primary flex-grow-1"
                                                >
                                                    <i class="bi bi-pencil me-1"></i>
                                                    Editar
                                                </a>


                                                <form
                                                    class="form-excluir flex-grow-1"
                                                    action="/ponto/excluir/<%= ponto.id %>"
                                                    method="POST"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="btn btn-outline-danger w-100"
                                                    >
                                                        <i class="bi bi-trash me-1"></i>
                                                        Excluir
                                                    </button>

                                                </form>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>

                            </div>

                        <% }) %>


                    <% } else { %>

                        <div class="col-12">

                            <div class="card border-0 shadow-sm empty-card">

                                <div class="card-body text-center py-5">

                                    <div class="empty-icon mb-3">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>

                                    <h4 class="fw-bold">
                                        Nenhum ponto cadastrado
                                    </h4>

                                    <p class="text-muted mb-4">
                                        Ainda não existem pontos cadastrados no sistema.
                                    </p>

                                    <% if (usuario && usuario.tipo === 'ADMIN') { %>

                                        <a
                                            href="/ponto/cadastrar"
                                            class="btn btn-danger px-4"
                                        >
                                            <i class="bi bi-plus-lg me-1"></i>
                                            Cadastrar Primeiro Ponto
                                        </a>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    <% } %>

                </div>

            </div>

        </main>

    </div>


    <%- include('../../partials/scripts') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        .ponto-card {
            border-radius: 14px;
            transition: all 0.2s ease;
            overflow: hidden;
        }

        .ponto-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,.10) !important;
        }

        .icone-ponto {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: #f8eaea;
            color: #8b2e2e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
            flex-shrink: 0;
        }

        .titulo-info {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: #777;
            letter-spacing: .4px;
        }

        .info-box,
        .coordenada {
            background: #f7f7f7;
            border-radius: 10px;
            padding: 12px 14px;
        }

        .info-box i {
            color: #8b2e2e;
            font-size: 18px;
        }

        .coordenada strong {
            font-size: 13px;
            word-break: break-word;
        }

        .btn {
            border-radius: 8px;
        }

        .btn-danger {
            background: #8b2e2e;
            border-color: #8b2e2e;
        }

        .btn-danger:hover {
            background: #6f2323;
            border-color: #6f2323;
        }

        .btn-outline-danger {
            color: #8b2e2e;
            border-color: #8b2e2e;
        }

        .btn-outline-danger:hover {
            color: white;
            background: #8b2e2e;
            border-color: #8b2e2e;
        }

        .empty-card {
            border-radius: 14px;
        }

        .empty-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto;
            border-radius: 16px;
            background: #f8eaea;
            color: #8b2e2e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

    </style>


    <script>

        document.querySelectorAll('.form-excluir').forEach(form => {

            form.addEventListener('submit', event => {

                event.preventDefault();

                Swal.fire({

                    title: 'Excluir ponto?',

                    text: 'O ponto será removido do sistema e seus vínculos com rotas também serão excluídos.',

                    icon: 'warning',

                    showCancelButton: true,

                    confirmButtonText: 'Sim, excluir',

                    cancelButtonText: 'Cancelar',

                    confirmButtonColor: '#8b2e2e',

                    cancelButtonColor: '#6c757d'

                }).then(result => {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });

            });

        });

    </script>


    <% if (mensagem) { %>

        <script>

            Swal.fire({

                icon: '<%= mensagem.tipo %>',

                title: '<%= mensagem.tituloMensagem || mensagem.titulo || "" %>',

                text: '<%= mensagem.valor %>',

                confirmButtonColor: '#8b2e2e'

            });

        </script>

    <% } %>

</body>

</html>