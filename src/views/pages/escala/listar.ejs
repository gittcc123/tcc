<!DOCTYPE html>

<html lang="pt-BR">

<%- include('../../partials/head') %>

<body class="bg-light">

<%- include('../../partials/header') %>

<div class="d-flex">

    <%- include('../../partials/sidebar') %>

    <main class="content w-100 escala-page">

        <div class="escala-container">

            <!-- =====================================================
                 CABEÇALHO
            ====================================================== -->

            <div class="topo-pagina">

                <div class="titulo-area">

                    <div class="titulo-linha">

                        <span class="titulo-detalhe"></span>

                        <div>
                            <h1>Escalas de Trabalho</h1>

                            <p>
                                Gerencie as escalas de trabalho cadastradas no sistema.
                            </p>
                        </div>

                    </div>

                </div>

                <% if (usuario && usuario.tipo === 'ADMIN') { %>

                    <a
                        href="/escala/cadastrar"
                        class="btn-nova-escala"
                    >
                        <i class="bi bi-plus-lg"></i>
                        Nova escala
                    </a>

                <% } %>

            </div>


            <!-- =====================================================
                 MENSAGEM
            ====================================================== -->

            <% if (typeof mensagem !== 'undefined' && mensagem) { %>

                <div class="alerta-sistema">

                    <div class="alerta-icone">

                        <i class="bi
                            <%= mensagem.tipo === 'success'
                                ? 'bi-check-circle-fill'
                                : 'bi-exclamation-circle-fill' %>">
                        </i>

                    </div>

                    <div class="alerta-conteudo">

                        <strong>
                            <%= mensagem.tituloMensagem || mensagem.titulo || 'Aviso' %>
                        </strong>

                        <span>
                            <%= mensagem.valor || '' %>
                        </span>

                    </div>

                </div>

            <% } %>


            <!-- =====================================================
                 LISTAGEM
            ====================================================== -->

            <% if (escalas && escalas.length > 0) { %>

                <div class="lista-cabecalho">


                    <div class="contador">

                        <strong>
                            <%= escalas.length %>
                        </strong>

                        <span>
                            <%= escalas.length === 1 ? 'escala' : 'escalas' %>
                        </span>

                    </div>

                </div>


                <div class="escala-lista" id="lista-escalas">

                    <% escalas.forEach((escala, index) => { %>

                        <div class="escala-linha">

                            <!-- MARCADOR -->

                            <div class="escala-marcador">

                               
                            </div>


                            <!-- DESCRIÇÃO -->

                            <div class="escala-principal">

                                <div class="escala-titulo">

                                    <div>

                                        <i class="bi bi-calendar2-week"></i>

                                    </div>

                                    <div class="titulo-texto">

                                        <strong>
                                            <%= escala.descricao %>
                                        </strong>

                                        <span>
                                            Escala de trabalho
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- TURNO -->

                            <div class="escala-info">

                                <span class="info-label">
                                    Turno
                                </span>

                                <div class="info-valor">

                                    <i class="bi bi-clock"></i>

                                    <span>
                                        <%= escala.turno %>
                                    </span>

                                </div>

                            </div>


                            <!-- AÇÕES -->

                            <% if (usuario && usuario.tipo === 'ADMIN') { %>

                                <div class="acoes">

                                    <a
                                        href="/escala/editar/<%= escala.id %>"
                                        class="btn-acao btn-editar"
                                        title="Editar escala"
                                    >
                                        <i class="bi bi-pencil-square"></i>
                                        Editar
                                    </a>

                                    <form
                                        class="form-excluir"
                                        action="/escala/excluir/<%= escala.id %>"
                                        method="post"
                                    >

                                        <button
                                            type="submit"
                                            class="btn-acao btn-excluir"
                                            title="Excluir escala"
                                        >
                                            <i class="bi bi-trash3"></i>
                                            Excluir
                                        </button>

                                    </form>

                                </div>

                            <% } %>

                        </div>

                    <% }) %>

                </div>


            <% } else { %>


                <!-- =================================================
                     ESTADO VAZIO
                ================================================== -->

                <div class="empty-card">

                    <div class="empty-icon">

                        <i class="bi bi-calendar2-x"></i>

                    </div>

                    <h4>
                        Nenhuma escala cadastrada
                    </h4>

                    <p>
                        Ainda não existem escalas de trabalho cadastradas no sistema.
                    </p>

                    <% if (usuario && usuario.tipo === 'ADMIN') { %>

                        <a
                            href="/escala/cadastrar"
                            class="btn-nova-escala empty-button"
                        >
                            <i class="bi bi-plus-lg"></i>
                            Cadastrar primeira escala
                        </a>

                    <% } %>

                </div>

            <% } %>


            <!-- =====================================================
                 VOLTAR
            ====================================================== -->

            <div class="voltar-container">

                <a
                    href="/dashboard"
                    class="btn-voltar"
                >
                    <i class="bi bi-arrow-left"></i>
                    Voltar
                </a>

            </div>

        </div>

    </main>

</div>


<%- include('../../partials/scripts') %>


<!-- =============================================================
     SWEETALERT
============================================================= -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    const formsExcluir =
        document.querySelectorAll('.form-excluir');

    formsExcluir.forEach((formExcluir) => {

        formExcluir.addEventListener('submit', function (e) {

            e.preventDefault();

            Swal.fire({

                title: 'Deseja realmente excluir?',

                text: 'Esta ação não poderá ser desfeita.',

                icon: 'warning',

                showCancelButton: true,

                confirmButtonText: 'Sim, excluir',

                cancelButtonText: 'Cancelar',

                confirmButtonColor: '#c62828',

                cancelButtonColor: '#6c757d',

                reverseButtons: true

            }).then((result) => {

                if (result.isConfirmed) {

                    formExcluir.submit();

                }

            });

        });

    });

</script>


<!-- =============================================================
     MENSAGEM SWEETALERT
============================================================= -->

<% if (typeof mensagem !== 'undefined' && mensagem) { %>

    <script>

        Swal.fire({

            icon: '<%= mensagem.tipo || "info" %>',

            title:
                '<%= mensagem.tituloMensagem || mensagem.titulo || "Aviso" %>',

            text:
                '<%= mensagem.valor || "" %>',

            confirmButtonColor: '#c62828',

            confirmButtonText: 'OK'

        });

    </script>

<% } %>


<style>

    /* ============================================================
       BASE
    ============================================================ */

    .escala-page {

        min-height: calc(100vh - 70px);

        background:
            linear-gradient(
                180deg,
                #f5f6f7 0%,
                #f8f8f8 100%
            );

    }


    .escala-container {

        width: 100%;

        max-width: 1180px;

        margin: 0 auto;

        padding: 36px 28px 50px;

    }


    /* ============================================================
       CABEÇALHO
    ============================================================ */

    .topo-pagina {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 25px;

        margin-bottom: 30px;

    }


    .titulo-linha {

        display: flex;

        align-items: center;

        gap: 15px;

    }


    .titulo-detalhe {

        display: block;

        width: 5px;

        height: 54px;

        border-radius: 5px;

        background: #c62828;

        box-shadow:
            0 4px 10px rgba(198, 40, 40, .18);

    }


    .topo-pagina h1 {

        margin: 0;

        color: #252525;

        font-size: 29px;

        font-weight: 700;

        letter-spacing: -.7px;

    }


    .topo-pagina p {

        margin: 6px 0 0;

        color: #858585;

        font-size: 14px;

    }


    /* ============================================================
       BOTÃO NOVA ESCALA
    ============================================================ */

    .btn-nova-escala {

        height: 43px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        padding: 0 18px;

        background: #c62828;

        border: 1px solid #c62828;

        border-radius: 7px;

        color: #fff;

        font-size: 13px;

        font-weight: 600;

        text-decoration: none;

        white-space: nowrap;

        box-shadow:
            0 4px 10px rgba(198, 40, 40, .15);

        transition:
            background .2s,
            border-color .2s,
            transform .2s,
            box-shadow .2s;

    }


    .btn-nova-escala:hover {

        background: #a91f1f;

        border-color: #a91f1f;

        color: #fff;

        transform: translateY(-1px);

        box-shadow:
            0 6px 14px rgba(198, 40, 40, .2);

    }


    .btn-nova-escala i {

        font-size: 14px;

    }


    /* ============================================================
       MENSAGEM
    ============================================================ */

    .alerta-sistema {

        display: flex;

        align-items: center;

        gap: 13px;

        padding: 13px 16px;

        margin-bottom: 25px;

        background: #fff;

        border: 1px solid #ead2d2;

        border-left: 4px solid #c62828;

        border-radius: 8px;

        box-shadow:
            0 2px 7px rgba(0, 0, 0, .025);

    }


    .alerta-icone {

        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 7px;

        background: #fff3f3;

        color: #c62828;

    }


    .alerta-conteudo strong {

        display: block;

        margin-bottom: 2px;

        color: #333;

        font-size: 13px;

    }


    .alerta-conteudo span {

        display: block;

        color: #777;

        font-size: 12px;

    }


    /* ============================================================
       CABEÇALHO DA LISTA
    ============================================================ */

    .lista-cabecalho {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 13px;

        padding: 0 2px;

    }


    .lista-cabecalho h2 {

        margin: 0;

        color: #303030;

        font-size: 17px;

        font-weight: 700;

    }


    .lista-cabecalho p {

        margin: 4px 0 0;

        color: #999;

        font-size: 12px;

    }


    .contador {

        display: flex;

        align-items: baseline;

        gap: 5px;

        padding: 6px 11px;

        border: 1px solid #ead1d1;

        border-radius: 6px;

        background: #fff7f7;

    }


    .contador strong {

        color: #c62828;

        font-size: 16px;

    }


    .contador span {

        color: #888;

        font-size: 11px;

    }


    /* ============================================================
       LISTA
    ============================================================ */

    .escala-lista {

        position: relative;

        background: #fff;

        border: 1px solid #e1e1e1;

        border-radius: 10px;

        overflow: hidden;

        box-shadow:
            0 3px 12px rgba(0, 0, 0, .035);

    }


    .escala-lista::before {

        content: "";

        display: block;

        position: absolute;

        top: 0;

        left: 0;

        width: 100%;

        height: 3px;

        background: #c62828;

    }


    .escala-linha {

        position: relative;

        display: grid;

        grid-template-columns:
            46px
            minmax(0, 1.6fr)
            minmax(130px, .8fr)
            auto;

        align-items: center;

        gap: 16px;

        min-height: 82px;

        padding: 15px 22px;

        border-bottom: 1px solid #ededed;

        transition:
            background .2s,
            padding-left .2s;

    }


    .escala-linha:last-child {

        border-bottom: 0;

    }


    .escala-linha:hover {

        background: #fffafa;

        padding-left: 26px;

    }


    /* DETALHE VERMELHO AO PASSAR */

    .escala-linha::before {

        content: "";

        position: absolute;

        left: 0;

        top: 0;

        bottom: 0;

        width: 3px;

        background: #c62828;

        opacity: 0;

        transition: opacity .2s;

    }


    .escala-linha:hover::before {

        opacity: 1;

    }


    /* ============================================================
       MARCADOR
    ============================================================ */

    .escala-marcador {

        display: flex;

        justify-content: center;

    }


    .escala-marcador span {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        width: 34px;

        height: 30px;

        border: 1px solid #ead0d0;

        border-radius: 6px;

        background: #fff8f8;

        color: #b52222;

        font-size: 10px;

        font-weight: 700;

    }


    /* ============================================================
       DESCRIÇÃO
    ============================================================ */

    .escala-principal {

        min-width: 0;

    }


    .escala-titulo {

        display: flex;

        align-items: center;

        gap: 11px;

        min-width: 0;

    }


    .icone-escala {

        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 7px;

        background: #fff3f3;

        color: #c62828;

    }


    .icone-escala i {

        font-size: 15px;

    }


    .titulo-texto {

        min-width: 0;

    }


    .titulo-texto strong {

        display: block;

        overflow: hidden;

        color: #303030;

        font-size: 14px;

        font-weight: 650;

        text-overflow: ellipsis;

        white-space: nowrap;

    }


    .titulo-texto span {

        display: block;

        margin-top: 3px;

        color: #999;

        font-size: 11px;

    }


    /* ============================================================
       TURNO
    ============================================================ */

    .info-label {

        display: block;

        margin-bottom: 5px;

        color: #999;

        font-size: 10px;

        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: .5px;

    }


    .info-valor {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding: 6px 9px;

        border-radius: 6px;

        background: #fafafa;

        color: #3b3b3b;

        font-size: 13px;

        font-weight: 600;

    }


    .info-valor i {

        color: #c62828;

        font-size: 14px;

    }


    /* ============================================================
       AÇÕES
    ============================================================ */

    .acoes {

        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 7px;

    }


    .form-excluir {

        margin: 0;

    }


    .btn-acao {

        height: 35px;

        display: inline-flex;

        align-items: center;

        justify-content: center;
        
        gap: 6px;

        padding: 0 13px;

        border-radius: 6px;

        font-size: 12px;

        font-weight: 600;

        text-decoration: none;

        cursor: pointer;

        transition:
            background .2s,
            border-color .2s,
            color .2s,
            transform .2s;

    }


    .btn-editar {

        background: #fff;

        border: 1px solid #d8d8d8;

        color: #555;

    }


    .btn-editar:hover {

        background: #fff8f8;

        border-color: #d7aaaa;

        color: #a52222;

    }


    .btn-excluir {

        background: #fff;

        border: 1px solid #e2bcbc;

        color: #b52222;

    }


    .btn-excluir:hover {

        background: #c62828;

        border-color: #c62828;

        color: #fff;

        transform: translateY(-1px);

    }


    /* ============================================================
       ESTADO VAZIO
    ============================================================ */

    .empty-card {

        padding: 58px 20px;

        background: #fff;

        border: 1px solid #e1e1e1;

        border-top: 3px solid #c62828;

        border-radius: 10px;

        text-align: center;

        box-shadow:
            0 3px 12px rgba(0, 0, 0, .035);

    }


    .empty-icon {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        width: 62px;

        height: 62px;

        margin-bottom: 14px;

        border: 1px solid #e8caca;

        border-radius: 50%;

        background: #fff5f5;

        color: #c62828;

        font-size: 26px;

    }


    .empty-card h4 {

        margin-bottom: 6px;

        color: #303030;

        font-size: 16px;

        font-weight: 700;

    }


    .empty-card p {

        max-width: 440px;

        margin: 0 auto 20px;

        color: #999;

        font-size: 13px;

    }


    .empty-button {

        display: inline-flex;

    }




    .voltar-container {

        margin-top: 24px;

    }


    .btn-voltar {

        height: 40px;

        display: inline-flex;

        align-items: center;

        gap: 8px;

        padding: 0 15px;

        background: #fff;

        border: 1px solid #dedede;

        border-radius: 7px;

        color: #555;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;

        transition: .2s;

    }


    .btn-voltar:hover {

        color: #c62828;

        border-color: #d4aaaa;

        background: #fff;

    }


    /* ============================================================
       RESPONSIVO
    ============================================================ */

    @media (max-width: 900px) {

        .escala-linha {

            grid-template-columns:
                40px
                minmax(0, 1fr)
                auto;

            grid-template-areas:
                "numero principal acoes"
                ".      info      info";

            row-gap: 12px;

        }


        .escala-marcador {

            grid-area: numero;

        }


        .escala-principal {

            grid-area: principal;

        }


        .escala-info {

            grid-area: info;

        }


        .acoes {

            grid-area: acoes;

        }

    }


    @media (max-width: 650px) {

        .escala-container {

            padding: 24px 15px 35px;

        }


        .topo-pagina {

            align-items: stretch;

            flex-direction: column;

        }


        .titulo-linha {

            align-items: flex-start;

        }


        .titulo-detalhe {

            height: 48px;

        }


        .topo-pagina h1 {

            font-size: 25px;

        }


        .btn-nova-escala {

            width: 100%;

        }


        .lista-cabecalho {

            align-items: flex-start;

        }


        .escala-linha {

            grid-template-columns:
                36px
                minmax(0, 1fr);

            grid-template-areas:
                "numero principal"
                ".      info"
                ".      acoes";

            padding: 15px 16px;

        }


        .escala-linha:hover {

            padding-left: 18px;

        }


        .acoes {

            justify-content: flex-start;

        }


        .btn-acao {

            flex: 1;

        }


        .voltar-container {

            margin-top: 20px;

        }


        .btn-voltar {

            width: 100%;

            justify-content: center;

        }

    }


    @media (max-width: 430px) {

        .titulo-linha {

            gap: 11px;

        }


        .titulo-detalhe {

            width: 4px;

            height: 45px;

        }


        .topo-pagina h1 {

            font-size: 22px;

        }


        .topo-pagina p {

            font-size: 12px;

        }


        .lista-cabecalho {

            flex-direction: column;

            gap: 8px;

        }


        .contador {

            align-self: flex-start;

        }


        .escala-linha {

            gap: 10px;

        }


        .acoes {

            flex-direction: column;

            align-items: stretch;

            width: 100%;

        }


        .btn-acao {

            width: 100%;

        }

    }

</style>

</body>
</html>
