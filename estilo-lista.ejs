<style>
    :root {
        --red: #7a1f1f;
        --red-dark: #5f1717;
        --red-soft: #faf2f2;
        --red-border: #ead4d4;
        --text: #242424;
        --muted: #747474;
        --border: #e6e7e9;
        --bg: #f5f6f8;
    }

    .pg { min-height: calc(100vh - 70px); padding: 32px; background: var(--bg); }

    /* ===== Cabeçalho ===== */
    .pg-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
    .pg-title { margin: 0; color: var(--text); font-size: 30px; font-weight: 800; letter-spacing: -.6px; line-height: 1.15; }
    .pg-description { margin: 6px 0 0; color: var(--muted); font-size: 14px; }
    .pg-acoes { display: flex; align-items: center; gap: 9px; flex-shrink: 0; }

    .btn-principal, .btn-voltar {
        height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        padding: 0 17px; border-radius: 10px; font-size: 14px; font-weight: 700; text-decoration: none; transition: .18s ease;
    }
    .btn-principal { color: #fff; background: var(--red); border: 1px solid var(--red); box-shadow: 0 4px 12px rgba(122, 31, 31, .18); }
    .btn-principal:hover { color: #fff; background: var(--red-dark); border-color: var(--red-dark); transform: translateY(-1px); }
    .btn-voltar { color: #555; background: #fff; border: 1px solid #dedfe2; }
    .btn-voltar:hover { color: var(--red); border-color: var(--red-border); }

    /* ===== Resumo (opcional) ===== */
    .pg-resumo { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 18px; }
    .resumo-card { display: flex; align-items: center; gap: 13px; padding: 14px 16px; background: #fff; border: 1px solid var(--border); border-radius: 16px; }
    .resumo-icone { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--red-soft); color: var(--red); font-size: 18px; flex-shrink: 0; }
    .resumo-label { color: var(--muted); font-size: 12.5px; }
    .resumo-valor { color: var(--text); font-size: 22px; font-weight: 800; line-height: 1.1; }

    /* ===== Busca ===== */
    .pg-barra { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
    .pg-busca { position: relative; flex: 1; max-width: 420px; }
    .pg-busca i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); }
    .pg-busca input {
        width: 100%; height: 44px; padding: 0 14px 0 40px; font-size: 15px; outline: none;
        background: #fff; border: 1px solid var(--border); border-radius: 12px;
    }
    .pg-busca input:focus { border-color: var(--red); box-shadow: 0 0 0 3px rgba(122, 31, 31, .12); }
    .pg-total { color: var(--muted); font-size: 13px; }

    /* ===== Lista ===== */
    .pg-lista { display: flex; flex-direction: column; gap: 10px; }

    .item {
        display: grid; grid-template-columns: auto 1fr auto auto;
        grid-template-areas: "num info meta acoes";
        align-items: center; gap: 16px; padding: 14px 16px;
        background: #fff; border: 1px solid var(--border); border-radius: 16px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .item:hover { border-color: var(--red-border); box-shadow: 0 6px 20px rgba(122, 31, 31, .08); }

    .item-num {
        grid-area: num; min-width: 46px; height: 46px; padding: 0 10px; display: flex; align-items: center; justify-content: center;
        border-radius: 14px; background: var(--red); color: #fff; font-size: 15px; font-weight: 800; white-space: nowrap;
    }
    .item-num.suave { background: var(--red-soft); color: var(--red); font-size: 19px; }

    .item-info { grid-area: info; min-width: 0; }
    .item-nome { color: var(--text); font-size: 16px; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
    .item-sub { margin-top: 3px; color: #9a9ea5; font-size: 12.5px; overflow-wrap: anywhere; }

    .item-meta { grid-area: meta; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; }

    .chip { display: inline-flex; align-items: baseline; gap: 6px; padding: 7px 12px; border-radius: 10px; background: var(--red-soft); }
    .chip b { color: var(--red); font-size: 15px; font-weight: 800; }
    .chip small { color: #9b7777; font-size: 12px; font-weight: 600; }
    .chip.neutro { background: #f3f4f6; }
    .chip.neutro b { color: #3b3f45; font-size: 14px; }
    .chip.neutro small { color: #8a8f94; }
    .chip.ok { background: #e9f7ef; }
    .chip.ok b { color: #198754; font-size: 13px; }
    .chip.off { background: #fbeaec; }
    .chip.off b { color: #b02a37; font-size: 13px; }

    .item-acoes { grid-area: acoes; display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
    .item-acoes form { margin: 0; }

    .btn-item, .btn-editar, .btn-excluir {
        height: 38px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        padding: 0 13px; border-radius: 10px; font-size: 13px; font-weight: 700; text-decoration: none; cursor: pointer; transition: .17s ease;
    }
    .btn-item { color: #fff; background: var(--red); border: 1px solid var(--red); }
    .btn-item:hover { color: #fff; background: var(--red-dark); border-color: var(--red-dark); }
    .btn-editar { color: #555; background: #fff; border: 1px solid #dedfe2; }
    .btn-editar:hover { color: var(--red); background: var(--red-soft); border-color: var(--red-border); }
    .btn-excluir { color: #8b2e2e; background: #fff; border: 1px solid #dfc3c3; }
    .btn-excluir:hover { color: #fff; background: var(--red); border-color: var(--red); }

    .btn-item:focus-visible, .btn-editar:focus-visible, .btn-excluir:focus-visible,
    .btn-principal:focus-visible, .btn-voltar:focus-visible { outline: 3px solid rgba(122, 31, 31, .35); outline-offset: 2px; }

    /* Itens com várias informações: informações ficam numa segunda linha */
    .item.item-largo { grid-template-columns: auto 1fr auto; grid-template-areas: "num info acoes" "meta meta meta"; }
    .item.item-largo .item-meta { justify-content: flex-start; padding-top: 12px; border-top: 1px solid #f0f0f2; }

    /* ===== Vazio ===== */
    .sem-itens { padding: 60px 20px; text-align: center; background: #fff; border: 1px dashed var(--red-border); border-radius: 16px; }
    .sem-itens-icone { width: 58px; height: 58px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; border-radius: 16px; background: var(--red-soft); color: var(--red); font-size: 24px; }
    .sem-itens h5 { margin: 0 0 7px; color: #444; font-size: 16px; font-weight: 700; }
    .sem-itens p { margin: 0 0 16px; color: var(--muted); font-size: 13px; }
    .sem-itens p:last-child { margin-bottom: 0; }

    /* ===== Tablet ===== */
    @media (max-width: 1000px) {
        .item:not(.item-largo) { grid-template-columns: auto 1fr auto; grid-template-areas: "num info acoes" "meta meta meta"; }
        .item:not(.item-largo) .item-meta { justify-content: flex-start; }
    }

    /* ===== Celular ===== */
    @media (max-width: 768px) {
        .pg { padding: 20px 14px; }
        .pg-header { align-items: stretch; flex-direction: column; gap: 16px; }
        .pg-title { font-size: 25px; }
        .pg-acoes { width: 100%; }
        .btn-principal, .btn-voltar { flex: 1; }
        .pg-busca { max-width: none; }
        .pg-total { display: none; }
        .pg-resumo { grid-template-columns: 1fr; }

        .item { gap: 12px; padding: 14px; }
        .item-num { min-width: 42px; height: 42px; }
        .item-acoes .rotulo-admin { display: none; }
        .btn-editar, .btn-excluir { width: 38px; padding: 0; }
    }
</style>
